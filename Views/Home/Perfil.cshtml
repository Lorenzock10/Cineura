@using Cineura.Models
@{
    Layout = null;
    ViewData["Title"] = "Perfil";

    string nombreUsuario = Context.Session.GetString("nombre") ?? "Usuario";
    string apellidoUsuario = Context.Session.GetString("apellido") ?? "";
    string handleUsuario = Context.Session.GetString("usuario") ?? "usuario";

    string iniciales = "";
    if (!string.IsNullOrEmpty(nombreUsuario)) iniciales += nombreUsuario[0];
    if (!string.IsNullOrEmpty(apellidoUsuario)) iniciales += apellidoUsuario[0];
    if (string.IsNullOrEmpty(iniciales)) iniciales = "U";

    List<Peliculas> misFavoritas = ViewBag.MisFavoritas as List<Peliculas> ?? new List<Peliculas>();
    int cantidadFavoritas = ViewBag.CantidadFavoritas ?? 0;
    string gustosAdn = ViewBag.GustosAdn ?? "";

    List<KeyValuePair<string, int>> actoresFrecuentes = ViewBag.ActoresFrecuentes as List<KeyValuePair<string, int>> ?? new List<KeyValuePair<string, int>>();
    List<KeyValuePair<string, int>> directoresFrecuentes = ViewBag.DirectoresFrecuentes as List<KeyValuePair<string, int>> ?? new List<KeyValuePair<string, int>>();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cineura</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/perfil.css" asp-append-version="true" />
</head>
<body>
    <header class="cineura-header">
        <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap gap-3">
            <a asp-controller="Home" asp-action="Index" class="cineura-logo-header">
                <img src="~/imagenes/cineura.jpg" alt="Cineura" />
            </a>
            <nav class="d-flex align-items-center flex-wrap gap-3" aria-label="Navegación principal">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <a asp-controller="Explorador" asp-action="Index">Explorador</a>
                <a asp-controller="Watchlist" asp-action="Index">Watchlist</a>
                <a asp-controller="Home" asp-action="Perfil">Perfil</a>
            </nav>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span>Hola, @nombreUsuario</span>
                <a href="@Url.Action("CerrarSesion", "Home")"
   class="cineura-btn-cerrar-sesion">
    Cerrar sesión
</a>
            </div>
        </div>
    </header>

    <main role="main" class="cineura-contenido">
        <div class="perfil-container">
            <!-- 1. SECCIÓN SUPERIOR: DATOS DE USUARIO, STATS Y ADN -->
            <section class="profile-header-grid">
                <div class="user-card-main">
                    <div class="avatar-circle">
                        <span>@iniciales.ToUpper()</span>
                    </div>
                    <div class="user-info">
                        <h2>@nombreUsuario @apellidoUsuario</h2>
                        <span class="user-handle">@@@handleUsuario</span>
                        <div class="user-badges">
                            <span class="badge badge-primary">✦ Miembro activo</span>
                            <span class="badge badge-secondary">Perfil privado</span>
                        </div>
                        <p class="user-bio">Bienvenido a tu perfil en Cineura.</p>
                    </div>
                </div>

                <div class="stats-card">
                    <div class="stat-item">
                        <span class="stat-title">FAVORITAS</span>
                        <span class="stat-number">@cantidadFavoritas</span>
                        <span class="stat-sub">Guardadas</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <span class="stat-title">VALORACIÓN</span>
                        <span class="stat-number">-</span>
                        <span class="stat-sub">Promedio</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <span class="stat-title">RESEÑAS</span>
                        <span class="stat-number">0</span>
                        <span class="stat-sub">Publicadas</span>
                    </div>
                </div>

                <div class="adn-card">
                    <div class="adn-header"><h3>✦ ADN Cinematográfico</h3></div>
                    <p class="adn-desc">Ingresá tus gustos, géneros o la vibra que buscás para generar recomendaciones personalizadas:</p>
                    @if (TempData["Mensaje"] != null)
                    {
                        <p class="alert alert-success" role="status">@TempData["Mensaje"]</p>
                    }
                    @if (TempData["ErrorAdn"] != null)
                    {
                        <p class="alert alert-danger" role="alert">@TempData["ErrorAdn"]</p>
                    }
                    <form action="@Url.Action("GuardarAdn", "Home")" method="post" class="perfil-adn-form">
                        @Html.AntiForgeryToken()
                        <textarea name="gustosAdn" rows="3" required maxlength="2000" placeholder="Ej: Me gusta la ciencia ficción, thrillers psicológicos, dramas con finales abiertos..." class="perfil-adn-textarea">@gustosAdn</textarea>
                        <button type="submit" class="btn-adjust">Guardar preferencias</button>
                    </form>
                </div>
            </section>

            <!-- 2. MIS PELÍCULAS FAVORITAS -->
            <section class="section-block">
                <h3 class="section-title"><span class="icon-heart">❤️</span> MIS PELÍCULAS FAVORITAS</h3>
                @if (misFavoritas.Count > 0)
                {
                    <div class="movies-grid">
                        @foreach (Peliculas peli in misFavoritas)
                        {
                            <div class="movie-card">
                                <a href="@Url.Action("Detalles", "Home", new { id = peli.IdPelicula })" class="perfil-pelicula-link">
                                    <div class="poster-wrapper">
                                        @if (!string.IsNullOrEmpty(peli.PosterUrl))
                                        {
                                            <img src="@peli.PosterUrl" alt="@peli.Titulo" />
                                        }
                                        else
                                        {
                                            <div class="perfil-poster-sin-imagen">@peli.Titulo</div>
                                        }
                                    </div>
                                    <h4 class="perfil-pelicula-titulo">@peli.Titulo</h4>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="perfil-texto-vacio">Todavía no agregaste películas a tus Favoritas.</p>
                }
            </section>

            <!-- 3. ACTORES Y DIRECTORES FRECUENTES -->
            <section class="section-block">
                <h3 class="section-title">🟡 ACTORES FRECUENTES</h3>
                @if (actoresFrecuentes.Count > 0)
                {
                    <div class="people-row">
                        @foreach (KeyValuePair<string, int> actor in actoresFrecuentes)
                        {
                            <div class="person-chip">
                                <div class="chip-avatar"></div>
                                <div class="chip-info">
                                    <strong>@actor.Key</strong>
                                    <span>@actor.Value película(s) en favoritas</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="perfil-texto-vacio">Agregá películas a tus favoritas para calcular tus actores más frecuentes.</p>
                }
            </section>

            <section class="section-block">
                <h3 class="section-title">🎬 DIRECTORES FRECUENTES</h3>
                @if (directoresFrecuentes.Count > 0)
                {
                    <div class="people-row">
                        @foreach (KeyValuePair<string, int> director in directoresFrecuentes)
                        {
                            <div class="person-chip">
                                <div class="chip-avatar"></div>
                                <div class="chip-info">
                                    <strong>@director.Key</strong>
                                    <span>@director.Value película(s) en favoritas</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="perfil-texto-vacio">Agregá películas a tus favoritas para calcular tus directores más frecuentes.</p>
                }
            </section>

            <!-- 4. BLOQUE INFERIOR -->
            <div class="bottom-three-columns">
                <div class="sub-block">
                    <h3 class="section-title">✦ Recomendaciones del día</h3>
                    <p class="perfil-texto-informativo">Completá tu ADN cinematográfico para recibir recomendaciones personalizadas.</p>
                </div>
                <div class="sub-block">
                    <div class="sub-header"><h3 class="section-title">👥 Tus amigos</h3></div>
                    <p class="perfil-texto-informativo perfil-margen-superior">No hay amigos agregados todavía.</p>
                </div>
                <div class="sub-block">
                    <h3 class="section-title">📑 Actividad reciente</h3>
                    <p class="perfil-texto-informativo perfil-margen-superior">No hay actividad reciente.</p>
                </div>
            </div>
        </div>
    </main>

    <footer class="cineura-footer">&copy; 2026 - Cineura</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
