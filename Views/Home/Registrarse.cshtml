@{
    ViewData["Title"] = "Registrarse";
}

<!--Formulario para registrar un usuario con nombre, apellido, nombre de usuario, contraseña y tipo de usuario (alumno/docente/coordinador/padre)-->
<div class="text-center">
    <h1 class="display-4">Registrarse</h1>

    @if(ViewBag.Error != null){
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form id="registroForm" method="post" action="@Url.Action("Registrarse", "Home")" onsubmit="return validarFormulario();">
        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" class="form-control" id="nombre" name="nombre" required>
            <div class="invalid-feedback" id="err-nombre"></div>
        </div>
        <div class="mb-3">
            <label for="apellido" class="form-label">Apellido</label>
            <input type="text" class="form-control" id="apellido" name="apellido" required>
            <div class="invalid-feedback" id="err-apellido"></div>
        </div>
        <div class="mb-3">
            <label for="usuario" class="form-label">Nombre de usuario</label>
            <input type="text" class="form-control" id="usuario" name="usuario" required>
            <div class="invalid-feedback" id="err-usuario"></div>
        </div>
        <div class="mb-3">
            <label for="contrasena" class="form-label">Contraseña</label>
            <input type="password" class="form-control" id="contrasena" name="contrasena" required>
            <div class="invalid-feedback" id="err-contrasena"></div>
        </div>
        <button type="submit" class="btn btn-success">Registrarse</button>
    </form>
</div>

<script src="/js/site.js"></script>