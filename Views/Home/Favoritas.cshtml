
@model List<Cineura.Models.Peliculas>

@{
    ViewData["Title"] = "Mis favoritas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Listas.css" asp-append-version="true" />
}

<div class="listas-pagina">
    <div class="listas-encabezado">
        <h1><span>♥</span> Mis películas favoritas</h1>
        <p>Tus películas preferidas, siempre a mano.</p>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="listas-mensaje">
            @TempData["Mensaje"]
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="listas-vacia">
            <span class="listas-vacia-icono">♥</span>
            <h2>Tu colección está vacía</h2>
            <p>Cuando agregues películas a Favoritas, aparecerán acá.</p>
            <a asp-controller="Explorador" asp-action="Index" class="listas-explorar">
                Explorar películas
            </a>
        </div>
    }
    else
    {
        <div class="listas-grid">
            @foreach (Cineura.Models.Peliculas pelicula in Model)
            {
                <div class="listas-poster-tarjeta">
                    <a asp-controller="Home"
                       asp-action="Detalles"
                       asp-route-id="@pelicula.IdPelicula"
                       class="listas-poster-enlace"
                       aria-label="Ver detalles de @pelicula.Titulo">

                        @if (!string.IsNullOrWhiteSpace(pelicula.PosterUrl))
                        {
                            <img src="@pelicula.PosterUrl"
                                 alt="Póster de @pelicula.Titulo"
                                 class="listas-poster" />
                        }
                        else
                        {
                            <div class="listas-poster listas-poster-sin-imagen">
                                <span>🎬</span>
                                <p>Ver película</p>
                            </div>
                        }
                    </a>

                    <form asp-controller="Home"
                          asp-action="QuitarFavorito"
                          method="post"
                          class="listas-form-quitar">

                        <input type="hidden"
                               name="idPelicula"
                               value="@pelicula.IdPelicula" />

                        <input type="hidden"
                               name="returnUrl"
                               value="/Home/Favoritas" />

                        <button type="submit"
                                class="listas-quitar listas-quitar-favorita"
                                aria-label="Quitar de Favoritas"
                                title="Quitar de Favoritas">
                            ×
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</div>
