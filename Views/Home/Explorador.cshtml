@model List<Cineura.Models.Peliculas>

@{
    Layout = null;
    ViewData["Title"] = "Explorador | Cineura";
    string usuarioSesion = Context.Session.GetString("usuario");
    string nombreSesion = Context.Session.GetString("nombre");

    List<Cineura.Models.Peliculas> destacadas = new List<Cineura.Models.Peliculas>();

    foreach (Cineura.Models.Peliculas pelicula in Model)
    {
        if (!string.IsNullOrWhiteSpace(pelicula.PosterUrl))
        {
            destacadas.Add(pelicula);
        }
    }

    for (int i = 0; i < destacadas.Count; i++)
    {
        for (int j = i + 1; j < destacadas.Count; j++)
        {
            if (destacadas[j].Anio > destacadas[i].Anio)
            {
                Cineura.Models.Peliculas auxiliar = destacadas[i];
                destacadas[i] = destacadas[j];
                destacadas[j] = auxiliar;
            }
        }
    }

    if (destacadas.Count > 5)
    {
        destacadas.RemoveRange(5, destacadas.Count - 5);
    }

    // Películas que el usuario ya tiene guardadas.
    List<int> idsFavoritos = ViewBag.IdsFavoritos ?? new List<int>();
    List<int> idsWatchlist = ViewBag.IdsWatchlist ?? new List<int>();
}



<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Explorador.css" asp-append-version="true" />
</head>
<body>
    <header class="cineura-header sticky-top">
        <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap gap-3">
            <a href="@Url.Action("Index", "Home")" class="cineura-logo-header">
                <img src="~/imagenes/cineura.jpg" alt="Cineura" />
            </a>
            @if (!string.IsNullOrEmpty(usuarioSesion))
            {
                <nav class="d-flex align-items-center gap-2 flex-wrap" aria-label="Navegación principal">
                    <a href="@Url.Action("Index", "Home")">Inicio</a>
                    <a href="@Url.Action("Index", "Explorador")">Explorador</a>
                    <a href="@Url.Action("Index", "Watchlist")">Watchlist</a>
                    <a href="@Url.Action("Perfil", "Home")">Perfil</a>
                </nav>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <span class="cineura-saludo">Hola, @nombreSesion</span>
                    <a class="btn cineura-btn-cerrar-sesion" href="@Url.Action("CerrarSesion", "Home")">Cerrar sesión</a>
                </div>
            }
            else
            {
                <nav class="d-flex align-items-center gap-2 flex-wrap" aria-label="Acceso a Cineura">
                    <a class="btn cineura-btn-header-login" href="@Url.Action("Login", "Home")">Iniciar sesión</a>
                    <a class="btn cineura-btn-header-registro" href="@Url.Action("Registrarse", "Home")">Crear cuenta</a>
                </nav>
            }
        </div>
    </header>
<main class="explorador">

    <!-- PRESENTACIÓN ORIGINAL DE CINEURA -->
    <section class="explorador-hero">

        <div class="explorador-hero-contenido">

            <span class="explorador-etiqueta">
                TU PRÓXIMA PELÍCULA TE ESPERA
            </span>

            <h1>
                El próximo gran<br />
                <span>descubrimiento</span>
            </h1>

            <p>
                Historias que te atrapan. Mundos que te sorprenden.
                Encontrá la película perfecta para vos.
            </p>

            <a href="#peliculas" class="explorador-hero-boton">
                Explorar películas <span>↓</span>
            </a>

        </div>

        <div class="explorador-hero-decoracion">

            <div class="explorador-hero-circulo explorador-hero-circulo-uno"></div>
            <div class="explorador-hero-circulo explorador-hero-circulo-dos"></div>

            <img src="/imagenes/cineura.jpg"
                 alt="Logo de Cineura"
                 style="display:block; width:280px; height:auto; object-fit:contain;" />

        </div>

    </section>


    <!-- CARRUSEL DE PELÍCULAS DESTACADAS -->
    @if (destacadas.Count > 0)
    {
        <section class="cineura-destacadas"
                 aria-label="Películas destacadas">

            @for (int i = 0; i < destacadas.Count; i++)
            {
                Cineura.Models.Peliculas pelicula = destacadas[i];

                bool esFavorito = idsFavoritos.Contains(pelicula.IdPelicula);
                bool estaEnWatchlist = idsWatchlist.Contains(pelicula.IdPelicula);

                <article class="cineura-destacada @(i == 0 ? "activa" : "")">

                    <div class="cineura-destacada-fondo"
                         style="background-image: url('@pelicula.PosterUrl');">
                    </div>

                    <div class="cineura-destacada-contenido">

                        <span class="cineura-destacada-etiqueta">
                            ✦ PELÍCULA DESTACADA
                        </span>

                        <h2>@pelicula.Titulo</h2>

                        <p class="cineura-destacada-datos">
                            @pelicula.Genero · @pelicula.Anio · @pelicula.DuracionMinutos min
                        </p>

                        <p class="cineura-destacada-sinopsis">
                            @pelicula.Sinopsis
                        </p>


                        <!-- BOTONES DEL CARRUSEL -->
                        <div class="cineura-destacada-acciones">

                            <!-- VER DETALLE -->
                            <a href="/Home/Detalles/@pelicula.IdPelicula"
                               class="cineura-destacada-boton principal">
                                ▶ Ver detalle
                            </a>


                            <!-- FAVORITOS -->
                            <button type="button"
                                    class="cineura-destacada-boton cineura-boton-favorito @(esFavorito ? "seleccionado" : "")"
                                    onclick="toggleDestacada(this, @pelicula.IdPelicula, 'favorito')">

                                @if (esFavorito)
                                {
                                    <text>♥ En Favoritos</text>
                                }
                                else
                                {
                                    <text>♡ Favoritos</text>
                                }

                            </button>


                            <!-- WATCHLIST -->
                            <button type="button"
                                    class="cineura-destacada-boton cineura-boton-watchlist @(estaEnWatchlist ? "seleccionado" : "")"
                                    onclick="toggleDestacada(this, @pelicula.IdPelicula, 'watchlist')">

                                @if (estaEnWatchlist)
                                {
                                    <text>✓ En Watchlist</text>
                                }
                                else
                                {
                                    <text>＋ Watchlist</text>
                                }

                            </button>


                            <!-- RESEÑAR -->
                            <a href="/Home/Detalles/@pelicula.IdPelicula#comentarios"
                               class="cineura-destacada-boton">
                                ✎ Reseñar
                            </a>

                        </div>

                    </div>

                </article>
            }


            <!-- FLECHA ANTERIOR -->
            <button type="button"
                    class="cineura-destacada-flecha anterior"
                    onclick="cambiarDestacada(-1)"
                    aria-label="Película anterior">
                &#10094;
            </button>


            <!-- FLECHA SIGUIENTE -->
            <button type="button"
                    class="cineura-destacada-flecha siguiente"
                    onclick="cambiarDestacada(1)"
                    aria-label="Película siguiente">
                &#10095;
            </button>


            <!-- INDICADORES -->
            <div class="cineura-destacada-indicadores">

                @for (int i = 0; i < destacadas.Count; i++)
                {
                    <button type="button"
                            class="cineura-destacada-punto @(i == 0 ? "activo" : "")"
                            onclick="irADestacada(@i)"
                            aria-label="Ver película destacada @(i + 1)">
                    </button>
                }

            </div>

        </section>
    }


    <!-- BUSCADOR ORIGINAL -->
    <section class="explorador-buscador-seccion">

        <div class="explorador-seccion-titulo">

            <div>

                <span class="explorador-mini-etiqueta">
                    ENCONTRÁ TU PRÓXIMA HISTORIA
                </span>

                <h2>¿Qué tenés ganas de ver?</h2>

            </div>

        </div>


        <form method="get"
              action="/Explorador/Index"
              class="explorador-buscador">

            <!-- BÚSQUEDA POR TÍTULO -->
            <div class="explorador-busqueda-principal">

                <span class="explorador-icono-busqueda">⌕</span>

                <input type="text"
                       id="busqueda"
                       name="busqueda"
                       value="@ViewBag.Busqueda"
                       placeholder="Buscá por título... Ej. Dune, Poor Things" />

                <button type="submit"
                        class="explorador-boton-buscar">
                    Buscar
                </button>

            </div>


            <!-- FILTROS -->
            <div class="explorador-filtros">

                <!-- GÉNERO -->
                <div class="explorador-campo">

                    <label for="genero">GÉNERO</label>

                    <select id="genero" name="genero">

                        <option value="">Todos los géneros</option>

                        <option value="Acción"
                                selected="@(ViewBag.Genero == "Acción" ? "selected" : null)">
                            Acción
                        </option>

                        <option value="Aventura"
                                selected="@(ViewBag.Genero == "Aventura" ? "selected" : null)">
                            Aventura
                        </option>

                        <option value="Ciencia ficción"
                                selected="@(ViewBag.Genero == "Ciencia ficción" ? "selected" : null)">
                            Ciencia ficción
                        </option>

                        <option value="Comedia"
                                selected="@(ViewBag.Genero == "Comedia" ? "selected" : null)">
                            Comedia
                        </option>

                        <option value="Drama"
                                selected="@(ViewBag.Genero == "Drama" ? "selected" : null)">
                            Drama
                        </option>

                        <option value="Fantasía"
                                selected="@(ViewBag.Genero == "Fantasía" ? "selected" : null)">
                            Fantasía
                        </option>

                        <option value="Terror"
                                selected="@(ViewBag.Genero == "Terror" ? "selected" : null)">
                            Terror
                        </option>

                        <option value="Suspenso"
                                selected="@(ViewBag.Genero == "Suspenso" ? "selected" : null)">
                            Suspenso
                        </option>

                    </select>

                </div>


                <!-- AÑO -->
                <div class="explorador-campo">

                    <label for="anio">AÑO</label>

                    <input type="number"
                           id="anio"
                           name="anio"
                           value="@ViewBag.Anio"
                           placeholder="Ej. 2024" />

                </div>


                <!-- DURACIÓN -->
                <div class="explorador-campo">

                    <label for="duracionMaxima">DURACIÓN</label>

                    <select id="duracionMaxima" name="duracionMaxima">

                        <option value="">Cualquier duración</option>

                        <option value="90"
                                selected="@(ViewBag.DuracionMaxima?.ToString() == "90" ? "selected" : null)">
                            Hasta 90 min
                        </option>

                        <option value="120"
                                selected="@(ViewBag.DuracionMaxima?.ToString() == "120" ? "selected" : null)">
                            Hasta 120 min
                        </option>

                        <option value="150"
                                selected="@(ViewBag.DuracionMaxima?.ToString() == "150" ? "selected" : null)">
                            Hasta 150 min
                        </option>

                        <option value="180"
                                selected="@(ViewBag.DuracionMaxima?.ToString() == "180" ? "selected" : null)">
                            Hasta 180 min
                        </option>

                    </select>

                </div>


                <!-- ORDENAR -->
                <div class="explorador-campo">

                    <label for="ordenar">ORDENAR POR</label>

                    <select id="ordenar" name="ordenar">

                        <option value="titulo"
                                selected="@(ViewBag.Ordenar != "anio" ? "selected" : null)">
                            Título
                        </option>

                        <option value="anio"
                                selected="@(ViewBag.Ordenar == "anio" ? "selected" : null)">
                            Año más reciente
                        </option>

                    </select>

                </div>

            </div>


            <!-- PIE DEL BUSCADOR -->
            <div class="explorador-buscador-pie">

                <span>
                    ✦ Personalizá tu búsqueda con los filtros
                </span>

                <a href="/Explorador/Index"
                   class="explorador-limpiar">
                    Limpiar filtros <span>↺</span>
                </a>

            </div>

        </form>

    </section>


    <!-- RESULTADOS QUE SE ACTUALIZAN CON FETCH -->
    @await Html.PartialAsync("_ResultadosExplorador", Model)


    <!-- PIE DEL EXPLORADOR -->
    <div class="explorador-final">

        <span>✦</span>

        <p>Hay una historia esperando ser descubierta.</p>

        <span>✦</span>

    </div>

</main>
    <footer class="cineura-footer text-center py-4">
        &copy; 2026 - Cineura
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
