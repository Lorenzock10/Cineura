
@model List<Cineura.Models.Peliculas>

@{
    ViewData["Title"] = "Explorador | Cineura";

    var peliculasCarrusel = Model
        .Where(p => !p.Titulo.Contains("Toy Story", StringComparison.OrdinalIgnoreCase))
        .Take(36)
        .ToList();
}

<link rel="stylesheet" href="~/css/Explorador.css" asp-append-version="true" />

<main class="explorador">

    <section class="explorador-hero">
        <div class="explorador-hero-contenido">
            <span class="explorador-etiqueta">
                <span class="explorador-etiqueta-icono">✦</span>
                TU PRÓXIMA PELÍCULA TE ESPERA
            </span>

            <h1>El próximo gran<br /><span>descubrimiento</span></h1>

            <p>
                Historias que te atrapan. Mundos que te sorprenden.
                Encontrá la película perfecta para vos.
            </p>

            <a href="#peliculas" class="explorador-hero-boton">
                Explorar películas <span>↓</span>
            </a>
        </div>

        <div class="explorador-hero-decoracion">
    <div class="explorador-hero-circulo explorador-hero-circulo-uno"></div>
    <div class="explorador-hero-circulo explorador-hero-circulo-dos"></div>

    <img src="/imagenes/cineura.jpg"
         alt="Logo de Cineura"
         style="display:block; width:280px; height:auto; object-fit:contain;" />
</div>
    </section>

    <section class="explorador-buscador-seccion">
        <div class="explorador-seccion-titulo">
            <div>
                <span class="explorador-mini-etiqueta">ENCONTRÁ TU PRÓXIMA HISTORIA</span>
                <h2>¿Qué tenés ganas de ver?</h2>
            </div>
        </div>

        <form method="get" action="/Explorador/Index" class="explorador-buscador">
            <div class="explorador-busqueda-principal">
                <span class="explorador-icono-busqueda">⌕</span>

                <input type="text"
                       id="busqueda"
                       name="busqueda"
                       value="@ViewBag.Busqueda"
                       placeholder="Buscá por título... Ej. Dune, Poor Things" />

                <button type="submit" class="explorador-boton-buscar">
                    Buscar
                </button>
            </div>

            <div class="explorador-filtros">
                <div class="explorador-campo">
                    <label for="genero">GÉNERO</label>
                    <select id="genero" name="genero">
                        <option value="">Todos los géneros</option>
                        <option value="Acción" selected="@(ViewBag.Genero == "Acción" ? "selected" : null)">Acción</option>
                        <option value="Aventura" selected="@(ViewBag.Genero == "Aventura" ? "selected" : null)">Aventura</option>
                        <option value="Ciencia ficción" selected="@(ViewBag.Genero == "Ciencia ficción" ? "selected" : null)">Ciencia ficción</option>
                        <option value="Comedia" selected="@(ViewBag.Genero == "Comedia" ? "selected" : null)">Comedia</option>
                        <option value="Drama" selected="@(ViewBag.Genero == "Drama" ? "selected" : null)">Drama</option>
                        <option value="Fantasía" selected="@(ViewBag.Genero == "Fantasía" ? "selected" : null)">Fantasía</option>
                        <option value="Terror" selected="@(ViewBag.Genero == "Terror" ? "selected" : null)">Terror</option>
                        <option value="Suspenso" selected="@(ViewBag.Genero == "Suspenso" ? "selected" : null)">Suspenso</option>
                    </select>
                </div>

                <div class="explorador-campo">
                    <label for="anio">AÑO</label>
                    <input type="number"
                           id="anio"
                           name="anio"
                           value="@ViewBag.Anio"
                           placeholder="Ej. 2024" />
                </div>

                <div class="explorador-campo">
                    <label for="duracionMaxima">DURACIÓN</label>
                    <select id="duracionMaxima" name="duracionMaxima">
                        <option value="">Cualquier duración</option>
                        <option value="90" selected="@(ViewBag.DuracionMaxima?.ToString() == "90" ? "selected" : null)">Hasta 90 min</option>
                        <option value="120" selected="@(ViewBag.DuracionMaxima?.ToString() == "120" ? "selected" : null)">Hasta 120 min</option>
                        <option value="150" selected="@(ViewBag.DuracionMaxima?.ToString() == "150" ? "selected" : null)">Hasta 150 min</option>
                        <option value="180" selected="@(ViewBag.DuracionMaxima?.ToString() == "180" ? "selected" : null)">Hasta 180 min</option>
                    </select>
                </div>

                <div class="explorador-campo">
                    <label for="ordenar">ORDENAR POR</label>
                    <select id="ordenar" name="ordenar">
                        <option value="titulo" selected="@(ViewBag.Ordenar != "anio" ? "selected" : null)">Título</option>
                        <option value="anio" selected="@(ViewBag.Ordenar == "anio" ? "selected" : null)">Año más reciente</option>
                    </select>
                </div>
            </div>

            <div class="explorador-buscador-pie">
                <span>✦ Personalizá tu búsqueda con los filtros</span>
                <a href="/Explorador/Index" class="explorador-limpiar">
                    Limpiar filtros <span>↺</span>
                </a>
            </div>
        </form>
    </section>

    <section class="explorador-resultados" id="peliculas">
        <div class="explorador-resultados-titulo">
            <div>
                <span class="explorador-mini-etiqueta">EL CATÁLOGO DE CINEURA</span>
                <h2>Películas para descubrir</h2>
                <p>Elegí una historia y dejate llevar.</p>
            </div>

            <div class="explorador-cantidad">
                <span class="explorador-cantidad-numero">@peliculasCarrusel.Count</span>
                <span class="explorador-cantidad-texto">PELÍCULAS</span>
            </div>
        </div>

        @if (peliculasCarrusel.Count > 0)
        {
            <div class="explorador-carrusel">
                <button type="button"
                        class="explorador-flecha"
                        onclick="moverCarrusel(-1)"
                        aria-label="Películas anteriores">
                    &#10094;
                </button>

                <div class="explorador-peliculas-carrusel" id="carruselPeliculas">
                    @foreach (Cineura.Models.Peliculas pelicula in peliculasCarrusel)
                    {
                        <a href="/Home/Detalles/@pelicula.IdPelicula"
                           class="explorador-poster-link"
                           title="@pelicula.Titulo"
                           aria-label="Ver detalle de @pelicula.Titulo">

                            @if (!string.IsNullOrEmpty(pelicula.PosterUrl))
                            {
                                <img class="explorador-poster"
                                     src="@pelicula.PosterUrl"
                                     alt="Póster de @pelicula.Titulo"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="explorador-poster-vacio">
                                    <span>✦</span>
                                    <p>CINEURA</p>
                                </div>
                            }
                        </a>
                    }
                </div>

                <button type="button"
                        class="explorador-flecha"
                        onclick="moverCarrusel(1)"
                        aria-label="Películas siguientes">
                    &#10095;
                </button>
            </div>
        }
        else
        {
            <div class="explorador-sin-resultados">
                <div class="explorador-sin-resultados-icono">⌕</div>
                <h3>No encontramos películas</h3>
                <p>Probá cambiando la búsqueda o quitando alguno de los filtros.</p>
                <a href="/Explorador/Index">Ver todas las películas</a>
            </div>
        }
    </section>

    <div class="explorador-final">
        <span>✦</span>
        <p>Hay una historia esperando ser descubierta.</p>
        <span>✦</span>
    </div>
</main>

<script>
    function moverCarrusel(direccion) {
        const carrusel = document.getElementById("carruselPeliculas");
        if (!carrusel) return;

        const poster = carrusel.querySelector(".explorador-poster-link");
        if (!poster) return;

        const estilos = window.getComputedStyle(carrusel);
        const espacio = parseFloat(estilos.gap) || 0;
        const anchoPoster = poster.getBoundingClientRect().width + espacio;

        carrusel.scrollBy({
            left: direccion * anchoPoster * 4,
            behavior: "smooth"
        });
    }
</script>
