<style>
    .modal-cineura {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .modal-cineura-tarjeta {
        position: relative;
        display: flex;
        gap: 20px;
        width: 100%;
        max-width: 600px;
        max-height: 85vh;
        overflow-y: auto;
        padding: 24px;
        background: #111827;
        color: white;
        border: 1px solid #374151;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    .modal-cineura-poster {
        width: 150px;
        align-self: flex-start;
        object-fit: cover;
        border-radius: 8px;
    }

    .modal-cineura-info {
        flex: 1;
        min-width: 0;
    }

    .modal-cineura-info h2 {
        color: #FBBF24;
        font-size: 22px;
        margin: 10px 25px 10px 0;
    }

    .modal-cineura-meta {
        color: #D1D5DB;
        font-size: 13px;
    }

    .modal-cineura-info p {
        line-height: 1.6;
    }

    .modal-cineura-cerrar {
        position: absolute;
        top: 8px;
        right: 12px;
        border: none;
        background: transparent;
        color: white;
        font-size: 28px;
        cursor: pointer;
    }

    @@media (max-width: 500px) {
        .modal-cineura-tarjeta {
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        .modal-cineura-poster {
            width: 125px;
        }

        .modal-cineura-info {
            width: 100%;
        }
    }
</style>

<script>
    function abrirDetallesCineura(id) {
        var modal = document.getElementById("detalle-cineura-" + id);

        if (modal) {
            modal.style.display = "flex";
        }
    }

    function cerrarDetallesCineura(id) {
        var modal = document.getElementById("detalle-cineura-" + id);

        if (modal) {
            modal.style.display = "none";
        }
    }

    function cerrarSiFondoCineura(evento, id) {
        if (evento.target.id === "detalle-cineura-" + id) {
            cerrarDetallesCineura(id);
        }
    }

    document.addEventListener("keydown", function (evento) {
        if (evento.key === "Escape") {
            document.querySelectorAll(".modal-cineura").forEach(function (modal) {
                modal.style.display = "none";
            });
        }
    });

    function agregarTexto(texto) {
        const campo = document.getElementById("busqueda");

        if (campo.value.trim() !== "") {
            campo.value += ", " + texto;
        } else {
            campo.value = texto;
        }

        campo.focus();
    }

    document.getElementById("formBusqueda").addEventListener("submit", async function (e) {
        e.preventDefault();

        const campo = document.getElementById("busqueda");
        const boton = document.getElementById("botonBuscar");
        const mensaje = document.getElementById("resultado");
        const contenedor = document.getElementById("resultadosBusqueda");

        mensaje.textContent = "Nova está buscando películas para vos...";
        contenedor.innerHTML = "";
        boton.disabled = true;

        try {
            const datos = new FormData();
            datos.append("busqueda", campo.value);

            const respuesta = await fetch("/Home/BuscarPeliculas", {
                method: "POST",
                body: datos
            });

            if (!respuesta.ok) {
                const error = await respuesta.text();
                throw new Error(error || "No se pudo realizar la búsqueda.");
            }

            const peliculas = await respuesta.json();

            if (!peliculas.length) {
                mensaje.textContent = "No encontramos películas con esos filtros. Probá describirlo de otra manera.";
                return;
            }

            mensaje.textContent = "Encontramos estas películas para vos:";

            peliculas.forEach(function (pelicula) {
                const columna = document.createElement("div");
                columna.className = "col";

                const tarjeta = document.createElement("div");
                tarjeta.className = "card-pelicula h-100";

                if (pelicula.posterUrl) {
                    const imagen = document.createElement("img");
                    imagen.src = pelicula.posterUrl;
                    imagen.alt = "Póster de " + pelicula.titulo;
                    imagen.className = "card-poster-img";
                    imagen.loading = "lazy";
                    tarjeta.appendChild(imagen);
                }

                const info = document.createElement("div");
                info.className = "card-info";

                const titulo = document.createElement("h4");
                titulo.className = "card-titulo";
                titulo.textContent = pelicula.titulo || "Sin título";

                const meta = document.createElement("p");
                meta.className = "card-meta";
                meta.textContent =
                    (pelicula.anio || "") + " • " +
                    (pelicula.duracionMinutos || "?") + " minutos";

                const genero = document.createElement("p");
                genero.textContent = pelicula.genero || "";

                const sinopsis = document.createElement("p");
                sinopsis.className = "card-sinopsis";
                sinopsis.textContent = pelicula.sinopsis || "Sin sinopsis disponible.";

                const enlace = document.createElement("a");
                enlace.className = "btn btn-outline-light btn-sm mt-2";
                enlace.textContent = "Ver detalles";
                enlace.href = "/Home/Detalles/" + pelicula.idPelicula;

                info.appendChild(titulo);
                info.appendChild(meta);
                info.appendChild(genero);
                info.appendChild(sinopsis);
                info.appendChild(enlace);
                tarjeta.appendChild(info);
                columna.appendChild(tarjeta);
                contenedor.appendChild(columna);
            });
        } catch (error) {
            mensaje.textContent = error.message || "Ocurrió un error al buscar películas.";
        } finally {
            boton.disabled = false;
        }
    });
</script>
