@{
    ViewData["Title"] = "Bienvenido a Cineura";
}

<div class="cineura-inicio">
    <div class="cineura-tarjeta">
            <div class="cineura-icono">
                <img src="~/imagenes/logo_c.jpg" alt="Cineura" />
            </div>
      <h1 class="cineura-titulo">
    <span class="cineura-rojo">CINE</span><span class="cineura-amarillo">URA</span>
</h1>

        <p class="cineura-descripcion">
            Descubrí tu próxima película favorita.
            Encontrá historias que vayan con vos.
        </p>

        <a href="@Url.Action("Login", "Home")"
           class="cineura-boton cineura-login">
            Iniciar sesión
        </a>

        <a href="@Url.Action("Registrarse", "Home")"
           class="cineura-boton cineura-registro">
            Crear una cuenta
        </a>

        <p class="cineura-pie">
            Tu próximo descubrimiento empieza acá.
        </p>

    </div>
</div>