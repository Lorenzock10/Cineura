
@{
    ViewData["Title"] = "Cineura | Buscador Inteligente";
}

<div class="cineura-pagina">
    <div class="cineura-contenedor">

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success text-center mt-3" role="alert">
                @TempData["Mensaje"]
            </div>
        }

        <div class="cineura-hero text-center mb-5">
            <div class="cineura-badge-neural mb-3">
                <span class="punto-verde">●</span>
                MOTOR NEURAL V4.2 ACTIVO • Calibrado a tu perfil cinematográfico
            </div>

            <h1 class="hero-titulo">¿Qué vibra o historia buscás vivir hoy?</h1>

            <p class="cineura-subtitulo hero-subtitulo">
                Describí una trama, un dilema moral, una atmósfera o un género y dejá que Nova encuentre películas para vos.
            </p>

            <div class="cineura-buscador-box">
                <form id="formBusqueda" method="post">
                    <div class="buscador-input-group">
                        <textarea id="busqueda"
                                  name="busqueda"
                                  class="form-control cineura-input-hero"
                                  rows="2"
                                  placeholder="Ej: Un thriller psicológico oscuro de menos de dos horas..."
                                  required></textarea>

                        <button type="submit" id="botonBuscar" class="cineura-boton-ia">
                            ✦ Generar recomendación
                        </button>
                    </div>
                </form>

                <div class="filtros-rapidos mt-3">
                    <div class="grupo-tags">
                        <span class="tag-label">MOODS:</span>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Cerebral y tenso')">Cerebral y tenso</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Melancólico')">Melancólico</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Adrenalina pura')">Adrenalina pura</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Existencialista')">Existencialista</button>
                    </div>

                    <div class="grupo-tags mt-2">
                        <span class="tag-label">ESTÉTICAS:</span>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Estilo A24')">✦ A24 Vibes</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Cine de autor')">Cine de autor</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Cyberpunk')">Cyberpunk</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Ciencia ficción de los años 70')">Sci-Fi 70s</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="resultado" class="text-center my-4" role="status"></div>
        <div id="resultadosBusqueda" class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 mb-5"></div>

        <div class="seccion-tendencias mt-5 pt-4">
            <div class="mb-4">
                <div class="cineura-badge-neural d-inline-block mb-1">
                    ● TRENDING NOW
                </div>
                <h2 class="h3 fw-bold text-white">Películas destacadas</h2>
                <p class="text-secondary small">
                    Explorá las películas y guardá las que te interesen.
                </p>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">

                <!-- DUNE -->
                <div class="col">
                    <div class="card-pelicula">
                        <div class="card-poster-wrap">
                            <img src="https://image.tmdb.org/t/p/w500/1pdfLvkbY9ohJlCjQH2CZjjYVvJ.jpg"
                                 class="card-poster-img"
                                 alt="Dune: Part Two"
                                 loading="lazy" />
                            <div class="card-score">★ 8.7</div>
                        </div>

                        <div class="card-info">
                            <div class="card-meta">2024 • 2h 46m</div>
                            <h4 class="card-titulo">Dune: Part Two</h4>
                            <div class="card-tags">
                                <span class="mini-tag">Ciencia ficción</span>
                                <span class="mini-tag">Aventura</span>
                            </div>
                            <p class="card-sinopsis">
                                Paul Atreides se une a Chani y los Fremen en una aventura por el destino de Arrakis.
                            </p>

                            <div class="mt-3 d-flex flex-wrap gap-2">
                                <button type="button"
                                        class="btn btn-outline-light btn-sm"
                                        onclick="abrirDetallesCineura('dune')">
                                    Ver detalles
                                </button>

                                <form asp-controller="Home" asp-action="AgregarFavorito" method="post">
                                    <input type="hidden" name="idPelicula" value="@ViewBag.IdDune" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">♥ Favoritas</button>
                                </form>

                                <form asp-controller="Home" asp-action="AgregarWatchlist" method="post">
                                    <input type="hidden" name="idPelicula" value="@ViewBag.IdDune" />
                                    <button type="submit" class="btn btn-warning btn-sm">+ Watchlist</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- POOR THINGS -->
                <div class="col">
                    <div class="card-pelicula">
                        <div class="card-poster-wrap">
                            <img src="https://image.tmdb.org/t/p/w500/kCGlIMHnOm8JPXq3rXM6c5wMxcT.jpg"
                                 class="card-poster-img"
                                 alt="Poor Things"
                                 loading="lazy" />
                            <div class="card-score">★ 8.4</div>
                        </div>

                        <div class="card-info">
                            <div class="card-meta">2023 • 2h 21m</div>
                            <h4 class="card-titulo">Poor Things</h4>
                            <div class="card-tags">
                                <span class="mini-tag">Fantasía</span>
                                <span class="mini-tag">Drama</span>
                            </div>
                            <p class="card-sinopsis">
                                Bella Baxter descubre el mundo y su propia libertad en una historia fantástica.
                            </p>

                            <div class="mt-3 d-flex flex-wrap gap-2">
                                <button type="button"
                                        class="btn btn-outline-light btn-sm"
                                        onclick="abrirDetallesCineura('poor-things')">
                                    Ver detalles
                                </button>

                                <form asp-controller="Home" asp-action="AgregarFavorito" method="post">
                                    <input type="hidden" name="idPelicula" value="@ViewBag.IdPoorThings" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">♥ Favoritas</button>
                                </form>

                                <form asp-controller="Home" asp-action="AgregarWatchlist" method="post">
                                    <input type="hidden" name="idPelicula" value="@ViewBag.IdPoorThings" />
                                    <button type="submit" class="btn btn-warning btn-sm">+ Watchlist</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- THE SUBSTANCE -->
                <div class="col">
                    <div class="card-pelicula">
                        <div class="card-poster-wrap">
                            <img src="https://image.tmdb.org/t/p/w500/lqoMzCcZYEFK729d6qzt349fB4o.jpg"
                                 class="card-poster-img"
                                 alt="The Substance"
                                 loading="lazy" />
                            <div class="card-score">★ 8.0</div>
                        </div>

                        <div class="card-info">
                            <div class="card-meta">2024 • 2h 21m</div>
                            <h4 class="card-titulo">The Substance</h4>
                            <div class="card-tags">
                                <span class="mini-tag">Terror</span>
                                <span class="mini-tag">Suspenso</span>
                            </div>
                            <p class="card-sinopsis">
                                Una celebridad recurre a un tratamiento extraordinario que cambiará su vida.
                            </p>

                            <div class="mt-3 d-flex flex-wrap gap-2">
                                <button type="button"
                                        class="btn btn-outline-light btn-sm"
                                        onclick="abrirDetallesCineura('substance')">
                                    Ver detalles
                                </button>

                                <form asp-controller="Home" asp-action="AgregarFavorito" method="post">
                                    <input type="hidden" name="idPelicula" value="@ViewBag.IdSubstance" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">♥ Favoritas</button>
                                </form>

                                <form asp-controller="Home" asp-action="AgregarWatchlist" method="post">
                                    <input type="hidden" name="idPelicula" value="@ViewBag.IdSubstance" />
                                    <button type="submit" class="btn btn-warning btn-sm">+ Watchlist</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ANATOMY OF A FALL -->
                <div class="col">
                    <div class="card-pelicula">
                        <div class="card-poster-wrap">
                            <img src="https://image.tmdb.org/t/p/w500/kQs6keheMwCxJxrzV83VUwFtHkB.jpg"
                                 class="card-poster-img"
                                 alt="Anatomy of a Fall"
                                 loading="lazy" />
                            <div class="card-score">★ 8.1</div>
                        </div>

                        <div class="card-info">
                            <div class="card-meta">2023 • 2h 31m</div>
                            <h4 class="card-titulo">Anatomy of a Fall</h4>
                            <div class="card-tags">
                                <span class="mini-tag">Drama</span>
                                <span class="mini-tag">Misterio</span>
                            </div>
                            <p class="card-sinopsis">
                                Una mujer es juzgada tras la muerte de su esposo y las pruebas dejan dudas sobre lo ocurrido.
                            </p>

                            <div class="mt-3 d-flex flex-wrap gap-2">
                                <button type="button"
                                        class="btn btn-outline-light btn-sm"
                                        onclick="abrirDetallesCineura('anatomy')">
                                    Ver detalles
                                </button>

                                <form asp-controller="Home" asp-action="AgregarFavorito" method="post">
                                    <input type="hidden" name="idPelicula" value="@ViewBag.IdAnatomy" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">♥ Favoritas</button>
                                </form>

                                <form asp-controller="Home" asp-action="AgregarWatchlist" method="post">
                                    <input type="hidden" name="idPelicula" value="@ViewBag.IdAnatomy" />
                                    <button type="submit" class="btn btn-warning btn-sm">+ Watchlist</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- CARTELITOS DE DETALLES -->

<div id="detalle-cineura-dune"
     class="modal-cineura"
     style="display:none;"
     onclick="cerrarSiFondoCineura(event, 'dune')">
    <div class="modal-cineura-tarjeta">
        <button type="button" class="modal-cineura-cerrar"
                onclick="cerrarDetallesCineura('dune')">×</button>
        <img src="https://image.tmdb.org/t/p/w500/1pdfLvkbY9ohJlCjQH2CZjjYVvJ.jpg"
             alt="Póster de Dune: Part Two" class="modal-cineura-poster" />
        <div class="modal-cineura-info">
            <h2>Dune: Part Two</h2>
            <p class="modal-cineura-meta">2024 · Ciencia ficción · 166 min</p>
            <p>Paul Atreides se une a Chani y los Fremen en una aventura por el destino de Arrakis.</p>
            <button type="button" class="btn btn-warning btn-sm"
                    onclick="cerrarDetallesCineura('dune')">Cerrar</button>
        </div>
    </div>
</div>

<div id="detalle-cineura-poor-things"
     class="modal-cineura"
     style="display:none;"
     onclick="cerrarSiFondoCineura(event, 'poor-things')">
    <div class="modal-cineura-tarjeta">
        <button type="button" class="modal-cineura-cerrar"
                onclick="cerrarDetallesCineura('poor-things')">×</button>
        <img src="https://image.tmdb.org/t/p/w500/kCGlIMHnOm8JPXq3rXM6c5wMxcT.jpg"
             alt="Póster de Poor Things" class="modal-cineura-poster" />
        <div class="modal-cineura-info">
            <h2>Poor Things</h2>
            <p class="modal-cineura-meta">2023 · Fantasía · 141 min</p>
            <p>Bella Baxter descubre el mundo y su propia libertad en una historia fantástica.</p>
            <button type="button" class="btn btn-warning btn-sm"
                    onclick="cerrarDetallesCineura('poor-things')">Cerrar</button>
        </div>
    </div>
</div>

