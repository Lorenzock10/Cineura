 @{
    ViewData["Title"] = "Bienvenido a Cineura";
}

<style>
    .cineura-inicio {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
        background-color: #111827;
        border-radius: 16px;
    }

    .cineura-tarjeta {
        width: 100%;
        max-width: 440px;
        padding: 45px 35px;
        text-align: center;
        background-color: #1F2937;
        border: 1px solid #374151;
        border-radius: 20px;
        color: #FFFFFF;
    }

    .cineura-logo {
        width: 75px;
        height: 75px;
        margin: 0 auto 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: #FBBF24;
        color: #111827;
        font-size: 38px;
        font-weight: bold;
    }

    .cineura-titulo {
        font-size: 32px;
        font-weight: bold;
        color: #FBBF24;
        margin-bottom: 12px;
    }

    .cineura-descripcion {
        color: #9CA3AF;
        font-size: 15px;
        margin-bottom: 30px;
    }

    .cineura-boton {
        display: block;
        width: 100%;
        padding: 13px;
        margin-top: 14px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: bold;
        text-decoration: none;
        transition: 0.2s;
    }

    .cineura-login {
        background-color: #FBBF24;
        color: #111827;
        border: 2px solid #FBBF24;
    }

    .cineura-login:hover {
        background-color: #F59E0B;
        border-color: #F59E0B;
        color: #111827;
    }

    .cineura-registro {
        background-color: transparent;
        color: #EF4444;
        border: 2px solid #EF4444;
    }

    .cineura-registro:hover {
        background-color: #EF4444;
        color: #FFFFFF;
    }

    .cineura-pie {
        margin-top: 28px;
        font-size: 12px;
        color: #6B7280;
    }
</style>

<div class="cineura-inicio">
    <div class="cineura-tarjeta">

        <div class="cineura-logo">C</div>

        <h1 class="cineura-titulo">Cineura</h1>

        <p class="cineura-descripcion">
            Descubrí tu próxima película favorita.
            Encontrá historias que vayan con vos.
        </p>

        <a href="@Url.Action("Login", "Home")"
           class="cineura-boton cineura-login">
            Iniciar sesión
        </a>

        <a href="@Url.Action("Registrarse", "Home")"
           class="cineura-boton cineura-registro">
            Crear una cuenta
        </a>

        <p class="cineura-pie">
            Tu próximo descubrimiento empieza acá.
        </p>

    </div>
</div>