@{
    ViewData["Title"] = "Bienvenido a Cineura";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 75vh;">
    <div class="card border-0 p-4 p-md-5 text-center" style="max-width: 440px; width: 100%; border-radius: 20px; background-color: var(--bg-card, #ffffff); box-shadow: var(--shadow-card, 0 4px 12px rgba(0,0,0,0.05));">
        
        <div class="mb-4">
            <div class="d-inline-flex align-items-center justify-content-center text-white rounded-circle shadow-sm" style="width: 72px; height: 72px; background-color: var(--primary, #0866ff);">
                <svg xmlns="http://www.w3.org/2000/svg" width="38" height="38" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16">
                    <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>
                </svg>
            </div>
        </div>

        <h1 class="h3 fw-bold mb-2" style="color: var(--text-primary, #050505);">Red Social</h1>
        <p class="mb-4" style="color: var(--text-secondary, #65676b); font-size: 0.95rem;">
            Un espacio para conectar y compartir.
        </p>

        <div class="d-grid gap-3">
            <a href="@Url.Action("Login", "Home")" class="btn btn-primary btn-lg fw-bold" style="border-radius: 12px; padding: 12px; background-color: var(--primary, #0866ff); border: none;">
                Iniciar Sesión
            </a>
            <a href="@Url.Action("Registrarse", "Home")" class="btn btn-outline-primary btn-lg fw-bold" style="border-radius: 12px; padding: 12px; border: 2px solid var(--primary, #0866ff); color: var(--primary, #0866ff);">
                Registrarse
            </a>
        </div>

    </div>
</div>