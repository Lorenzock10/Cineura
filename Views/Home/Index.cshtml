@using Cineura.Models
@{
    Layout = null;
    ViewData["Title"] = "Cineura | Descubrí qué sentir";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>
    <header class="cineura-header sticky-top">
        <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap gap-3">
            <a href="@Url.Action("Index", "Home")" class="cineura-logo-header">
                <img src="~/imagenes/cineura.jpg" alt="Cineura" />
            </a>
            <nav class="d-flex align-items-center gap-2 flex-wrap" aria-label="Acceso a Cineura">
                <a class="btn cineura-btn-header-login" href="@Url.Action("Login", "Home")">Iniciar sesión</a>
                <a class="btn cineura-btn-header-registro" href="@Url.Action("Registrarse", "Home")">Crear cuenta</a>
            </nav>
        </div>
    </header>

    <main class="landing-cineura">


        <section class="landing-hero" id="inicio">

    <div class="landing-hero-fondos" aria-hidden="true">
        <div class="landing-fondo landing-fondo-1"></div>
        <div class="landing-fondo landing-fondo-2"></div>
        <div class="landing-fondo landing-fondo-3"></div>
        <div class="landing-fondo landing-fondo-4"></div>
    </div>

    <div class="landing-hero-grid">
        <div class="landing-hero-content">

            <div class="landing-overline">
                <span class="landing-punto"></span>
                BIENVENIDO AL UNIVERSO CINEURA
            </div>

            <h1>
                No busques qué ver.
                <span>Descubrí qué sentir.</span>
            </h1>

            <p class="landing-hero-description">
                El cine no es solamente lo que ves.
                Es lo que te hace sentir. Descubrí historias
                que conecten con vos, tus gustos y tu estado de ánimo.
            </p>

            <div class="landing-hero-botones">
                <a asp-controller="Home"
                   asp-action="Registrarse"
                   class="landing-btn-rojo">
                    EMPEZAR A DESCUBRIR ↗
                </a>

                <a href="#tendencias" class="landing-btn-outline">
                    EXPLORAR PELÍCULAS
                </a>
            </div>

        </div>
    </div>

        </section>

        <div class="landing-franja">
            <span>✦</span>
            NO ES SOLO CINE
            <span>✦</span>
            ES UNA EXPERIENCIA
            <span>✦</span>
            NO ES SOLO CINE
            <span>✦</span>
        </div>

        <section class="landing-tendencias" id="tendencias">
            <div class="landing-inner">
                <div class="landing-seccion-header">
                    <div>
                        <div class="landing-overline">
                            01 / DESCUBRIMIENTO
                        </div>

                        <h2>
                            Historias que<br />
                            <span>merecen ser vistas.</span>
                        </h2>

                        <p>
                            Hay películas que te entretienen.
                            Otras se quedan con vos para siempre.
                            Encontrá tu próxima favorita.
                        </p>
                    </div>

                    <div class="landing-seccion-numero">01</div>
                </div>

                <div class="landing-movie-track">
                    @if (ViewBag.PeliculasTendencia != null)
                    {
                        @foreach (Peliculas pelicula in ViewBag.PeliculasTendencia)
                        {
                            <article class="landing-movie-card">
                                <a asp-controller="Home"
                                   asp-action="Registrarse"
                                   class="landing-movie-poster">
                                    <img src="@pelicula.PosterUrl"
                                         alt="Póster de @pelicula.Titulo"
                                         loading="lazy"
                                         onerror="this.onerror=null;this.src='https://placehold.co/500x750/111827/FBBF24?text=CINEURA';" />
                                    <div class="landing-movie-overlay">
                                        <span>✦</span>
                                        <strong>DESCUBRIR PELÍCULA</strong>
                                    </div>
                                </a>

                                <div class="landing-movie-info">
                                    <div class="landing-movie-meta">
                                        @pelicula.Anio
                                        <span>•</span>
                                        @pelicula.DuracionMinutos MIN
                                    </div>

                                    <h3>@pelicula.Titulo</h3>

                                    <div class="landing-movie-tags">
                                        @if (!string.IsNullOrEmpty(pelicula.Genero))
                                        {
                                            <span>@pelicula.Genero</span>
                                        }

                                        @if (!string.IsNullOrEmpty(pelicula.Animo))
                                        {
                                            <span>@pelicula.Animo</span>
                                        }
                                    </div>

                                    <a asp-controller="Home"
                                       asp-action="Registrarse"
                                       class="landing-movie-link">
                                        VER DETALLE ↗
                                    </a>
                                </div>
                            </article>
                        }
                    }
                </div>

                <div class="landing-track-indicacion">
                    DESLIZÁ PARA EXPLORAR MÁS ⟶
                </div>
            </div>
        </section>

        <section class="landing-problema">
            <div class="landing-inner landing-problema-grid">
                <div class="landing-problema-contenido">
                    <div class="landing-overline">
                        02 / EL PROBLEMA
                    </div>

                    <h2>
                        Demasiadas<br />
                        opciones.
                        <span>Muy poco<br />tiempo.</span>
                    </h2>

                    <p>
                        Abrís una plataforma. Mirás recomendaciones.
                        Pasás de una película a otra. Y después de
                        varios minutos, todavía no sabés qué ver.
                    </p>

                    <p>
                        Cineura nace para cambiar eso.
                        Porque tu tiempo debería estar dedicado
                        a disfrutar historias, no a buscarlas.
                    </p>

                    <div class="landing-problema-frase">
                        MENOS BÚSQUEDA. MÁS CINE.
                    </div>
                </div>

                <div class="landing-problema-visual">
                    <div class="landing-buscando-card">
                        <div class="landing-buscando-top">
                            <span>BUSCANDO ALGO PARA VER...</span>
                            <span class="landing-loading">● ● ●</span>
                        </div>

                        <div class="landing-buscando-linea"></div>
                        <div class="landing-buscando-linea corta"></div>
                        <div class="landing-buscando-linea"></div>

                        <div class="landing-buscando-error">
                            × DEMASIADAS OPCIONES
                        </div>
                    </div>

                    <div class="landing-buscando-solucion">
                        <span>✦</span>
                        CINEURA TIENE OTRA FORMA DE DESCUBRIR.
                    </div>
                </div>
            </div>
        </section>

        <section class="landing-ia" id="nova">
            <div class="landing-inner landing-ia-grid">
                <div class="landing-ia-demo">
                    <div class="landing-ia-window">
                        <div class="landing-ia-window-top">
                            <div class="landing-window-dots">
                                <span></span><span></span><span></span>
                            </div>
                            <span>CINEURA / NOVA AI</span>
                            <span class="landing-ia-status">● ACTIVO</span>
                        </div>

                        <div class="landing-ia-window-content">
                            <div class="landing-ia-label">
                                ¿QUÉ HISTORIA BUSCÁS HOY?
                            </div>

                            <div class="landing-ia-prompt">
                                Quiero un thriller psicológico,
                                oscuro y con un final inesperado...
                                <span class="landing-cursor">|</span>
                            </div>

                            <div class="landing-ia-tags">
                                <span>THRILLER</span>
                                <span>OSCURO</span>
                                <span>GIROS INESPERADOS</span>
                            </div>

                            <div class="landing-ia-response">
                                <div class="landing-ia-response-title">
                                    ✦ NOVA ENTIENDE TU BÚSQUEDA
                                </div>

                                <div class="landing-ia-response-line"></div>
                                <div class="landing-ia-response-line short"></div>

                                <div class="landing-ia-result">
                                    <div class="landing-ia-result-icon">✦</div>
                                    <div>
                                        <strong>Una recomendación pensada para vos.</strong>
                                        <small>Gustos + emociones + inteligencia artificial</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="landing-ia-texto">
                    <div class="landing-overline">
                        03 / INTELIGENCIA ARTIFICIAL
                    </div>

                    <h2>
                        No busques<br />
                        una película.
                        <span>Contanos qué<br />querés sentir.</span>
                    </h2>

                    <p>
                        Conocé Nova, el buscador inteligente de Cineura.
                        Escribí qué tipo de historia tenés ganas de ver
                        y descubrí películas que conecten con vos.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Registrarse"
                       class="landing-btn-rojo">
                        DESCUBRIR NOVA ↗
                    </a>
                </div>
            </div>
        </section>

        <section class="landing-experiencia">
            <div class="landing-inner">
                <div class="landing-seccion-header">
                    <div>
                        <div class="landing-overline">
                            04 / TU UNIVERSO
                        </div>

                        <h2>
                            Tu espacio.<br />
                            <span>Tu manera de vivir el cine.</span>
                        </h2>

                        <p>
                            No se trata solamente de encontrar películas.
                            Se trata de construir tu propio universo cinematográfico.
                        </p>
                    </div>
                </div>

                <div class="landing-experiencia-grid">
                    <article class="landing-feature feature-grande">
                        <div class="landing-feature-numero">01</div>
                        <div class="landing-feature-icon">✦</div>
                        <div class="landing-feature-contenido">
                            <h3>Descubrí historias que conectan con vos.</h3>
                            <p>
                                Recomendaciones según tus gustos,
                                preferencias y estado de ánimo.
                            </p>
                        </div>
                        <div class="landing-feature-decoration">
                            <span>DISCOVER</span>
                            <span>EXPLORE</span>
                            <span>FEEL</span>
                        </div>
                    </article>

                    <article class="landing-feature feature-roja">
                        <div class="landing-feature-numero">02</div>
                        <div class="landing-feature-icon">♡</div>
                        <div class="landing-feature-contenido">
                            <h3>Guardá tus favoritas.</h3>
                            <p>Conservá las películas que te marcaron.</p>
                        </div>
                    </article>

                    <article class="landing-feature feature-watchlist">
                        <div class="landing-feature-numero">03</div>
                        <div class="landing-feature-icon">▤</div>
                        <div class="landing-feature-contenido">
                            <h3>Tu próxima maratón.</h3>
                            <p>Organizá las películas que querés ver en tu Watchlist.</p>
                        </div>
                    </article>

                    <article class="landing-feature feature-comunidad">
                        <div class="landing-feature-numero">04</div>
                        <div class="landing-feature-icon">★★★★★</div>
                        <div class="landing-feature-contenido">
                            <h3>Compartí tu mirada.</h3>
                            <p>Comentá, puntuá y descubrí opiniones de otros usuarios.</p>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="landing-pasos">
            <div class="landing-inner">
                <div class="landing-overline">05 / EMPEZÁ TU EXPERIENCIA</div>

                <h2>
                    Tres pasos.<br />
                    <span>Un universo por descubrir.</span>
                </h2>

                <div class="landing-pasos-grid">
                    <div class="landing-paso">
                        <span>01</span>
                        <div class="landing-paso-linea"></div>
                        <h3>Creá tu perfil</h3>
                        <p>Registrate y empezá tu experiencia en Cineura.</p>
                    </div>

                    <div class="landing-paso">
                        <span>02</span>
                        <div class="landing-paso-linea"></div>
                        <h3>Descubrí historias</h3>
                        <p>Explorá tendencias y encontrá recomendaciones con Nova.</p>
                    </div>

                    <div class="landing-paso">
                        <span>03</span>
                        <div class="landing-paso-linea"></div>
                        <h3>Viví el cine</h3>
                        <p>Guardá, puntuá y compartí tus películas favoritas.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="landing-final">
            <div class="landing-final-contenido">
                <div class="landing-overline">
                    ✦ TU PRÓXIMA HISTORIA TE ESPERA
                </div>

                <h2>
                    El cine tiene<br />
                    miles de historias.
                    <span>Encontrá la tuya.</span>
                </h2>

                <p>
                    Dejá de buscar entre miles de opciones.
                    Empezá a descubrir películas que realmente sean para vos.
                </p>

                <a asp-controller="Home"
                   asp-action="Registrarse"
                   class="landing-btn-rojo">
                    CREAR MI CUENTA ↗
                </a>
            </div>

            <div class="landing-final-marca">
                CINEURA <span>✦</span>
            </div>
        </section>

    </main>
    <footer class="cineura-footer text-center py-4">
        &copy; 2026 - Cineura
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>
</body>
</html>
