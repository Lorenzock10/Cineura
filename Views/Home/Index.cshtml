@using Cineura.Models

@{
    ViewData["Title"] = "Cineura | Buscador Inteligente";
}

<div class="cineura-pagina">
    <div class="cineura-contenedor">

        <!-- BUSCADOR IA -->
        <div class="cineura-hero text-center mb-5">
            
            

            <h1 class="hero-titulo">¿Qué vibra o historia buscás vivir hoy?</h1>

            <p class="cineura-subtitulo hero-subtitulo">
               En Cineura no te elegimos la mejor película vos nos elegís a nosotros.
            </p>

            <div class="cineura-buscador-box">
                <form id="formBusqueda" class="w-100">
                    <div class="buscador-input-group">
                        <textarea id="busqueda"
                                  name="busqueda"
                                  class="form-control cineura-input-hero"
                                  rows="2"
                                  placeholder="Ej: Un thriller psicológico oscuro con giros inesperados..."
                                  required></textarea>

                        <button type="submit" id="botonBuscar" class="cineura-boton-ia">
                            ✦ Generar Recomendación
                        </button>
                    </div>
                </form>

                <!-- MOODS -->
                <div class="filtros-rapidos mt-3">
                    <div class="grupo-tags">
                        <span class="tag-label">MOODS:</span>

                        <button type="button" class="btn-tag" onclick="agregarTexto('Cerebral & Tenso')">
                            • Cerebral & Tenso
                        </button>

                        <button type="button" class="btn-tag" onclick="agregarTexto('Melancolía Nórdica')">
                            Melancolía Nórdica
                        </button>

                        <button type="button" class="btn-tag" onclick="agregarTexto('Adrenalina Pura')">
                            Adrenalina Pura
                        </button>

                        <button type="button" class="btn-tag" onclick="agregarTexto('Existencialista')">
                            Existencialista
                        </button>
                    </div>

                    <div class="grupo-tags mt-2">
                        <span class="tag-label">ESTÉTICAS:</span>

                        <button type="button" class="btn-tag tag-destacado" onclick="agregarTexto('A24 Vibes')">
                            ✦ A24 Vibes
                        </button>

                        <button type="button" class="btn-tag" onclick="agregarTexto('Cine de Autor')">
                            Cine de Autor
                        </button>

                        <button type="button" class="btn-tag" onclick="agregarTexto('Cyberpunk')">
                            Cyberpunk
                        </button>

                        <button type="button" class="btn-tag" onclick="agregarTexto('Sci-Fi 70s')">
                            Sci-Fi 70s
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MENSAJES DEL BUSCADOR -->
        <div id="resultado"
             class="cineura-estado text-center fs-5 my-4"
             role="status">
        </div>

        <!-- RESULTADO DE LA RECOMENDACIÓN -->
        <div id="recomendacion" class="cineura-recomendacion mb-5">
            <div class="row g-0">

                <div class="col-md-5" id="zonaPoster">
                    <div class="cineura-poster-vacio">
                        <span>✦ CINEURA</span>
                    </div>
                </div>

                <div class="col-md-7">
                    <div class="cineura-detalle">

                        <div class="cineura-subtitulo mb-2">
                            ✦ RECOMENDACIÓN PARA VOS
                        </div>

                        <h2 id="tituloPelicula">
                            Tu próxima película
                        </h2>

                        <div id="etiquetasPelicula" class="my-3"></div>

                        <p id="datosPelicula" class="cineura-datos"></p>

                        <h3 class="mt-4 fs-5 text-white">
                            Sinopsis
                        </h3>

                        <p id="descripcionPelicula" class="cineura-descripcion"></p>

                        <div class="cineura-motivo">
                            <h3>¿Por qué la elegimos para vos?</h3>
                            <p id="motivoPelicula"></p>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">

                            <button type="button"
                                    id="botonDetalles"
                                    class="cineura-boton-ia py-2 px-4 w-auto">
                                Ver detalles
                            </button>

                            <button type="button"
                                    id="botonOtra"
                                    class="cineura-boton-secundario">
                                ↻ Otra recomendación
                            </button>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PELÍCULAS EN TENDENCIA -->
        <div class="seccion-tendencias mt-5 pt-4">

            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>

                    <div class="cineura-badge-neural d-inline-block mb-1">
                        ● TRENDING NOW &nbsp;•&nbsp; ACTUALIZADO HOY
                    </div>

                    <h2 class="h3 fw-bold text-white mb-0">
                        Películas en Tendencias Globales
                    </h2>

                    <p class="text-secondary small mb-0">
                        Los estrenos más vistos y aclamados de la semana.
                    </p>

                </div>
            </div>

            <!-- TARJETAS DINÁMICAS DESDE SQL -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">

                @foreach (Peliculas pelicula in ViewBag.PeliculasTendencia)
                {
                    <div class="col">

                        <div class="card-pelicula">

                            <!-- PÓSTER -->
                            <div class="card-poster-wrap">

                                <img src="@pelicula.PosterUrl"
                                     class="card-poster-img"
                                     alt="Póster de @pelicula.Titulo"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='https://placehold.co/500x750/111827/FBBF24?text=Cineura';" />

                            </div>

                            <!-- INFORMACIÓN -->
                            <div class="card-info">

                                <div class="card-meta">
                                    @pelicula.Anio • @pelicula.DuracionMinutos min
                                </div>

                                <h4 class="card-titulo">
                                    @pelicula.Titulo
                                </h4>

                                <!-- ETIQUETAS -->
                                <div class="card-tags">

                                    @if (!string.IsNullOrEmpty(pelicula.Genero))
                                    {
                                        <span class="mini-tag">
                                            @pelicula.Genero
                                        </span>
                                    }

                                    @if (!string.IsNullOrEmpty(pelicula.Animo))
                                    {
                                        <span class="mini-tag">
                                            @pelicula.Animo
                                        </span>
                                    }

                                </div>

                                <!-- SINOPSIS -->
                                <p class="card-sinopsis">
                                    @pelicula.Sinopsis
                                </p>
                                <a asp-controller="Home" asp-action="Detalles" asp-route-id="@pelicula.IdPelicula" class="explorador-detalle">VER DETALLE</a>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>

    </div>
</div>
@section Scripts {
    <script src="~/js/home-index.js" asp-append-version="true"></script>
}
@section Styles {
    <link rel="stylesheet" href="~/css/home-index.css" asp-append-version="true" />
}