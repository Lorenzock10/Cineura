

@{
    ViewData["Title"] = "Cineura | Buscador Inteligente";
}

<div class="cineura-pagina">
    <div class="cineura-contenedor">

        <!-- BUSCADOR IA -->
        <div class="cineura-hero text-center mb-5">
            <div class="cineura-badge-neural mb-3">
                <span class="punto-verde">●</span>
                MOTOR NEURAL V4.2 ACTIVO &nbsp;•&nbsp; Calibrado a tu perfil cinematográfico
            </div>

            <h1 class="hero-titulo">¿Qué vibra o historia buscás vivir hoy?</h1>

            <p class="cineura-subtitulo hero-subtitulo">
                Describí una trama difusa, un dilema moral, una atmósfera particular o un género y dejá que la IA encuentre la opción ideal.
            </p>

            <div class="cineura-buscador-box">
                <form id="formBusqueda" class="w-100">
                    <div class="buscador-input-group">
                        <textarea id="busqueda"
                                  name="busqueda"
                                  class="form-control cineura-input-hero"
                                  rows="2"
                                  placeholder="Ej: Un thriller psicológico oscuro con giros inesperados..."
                                  required></textarea>

                        <button type="submit" id="botonBuscar" class="cineura-boton-ia">
                            ✦ Generar Recomendación
                        </button>
                    </div>
                </form>

                <!-- MOODS -->
                <div class="filtros-rapidos mt-3">
                    <div class="grupo-tags">
                        <span class="tag-label">MOODS:</span>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Cerebral & Tenso')">• Cerebral & Tenso</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Melancolía Nórdica')">Melancolía Nórdica</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Adrenalina Pura')">Adrenalina Pura</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Existencialista')">Existencialista</button>
                    </div>

                    <div class="grupo-tags mt-2">
                        <span class="tag-label">ESTÉTICAS:</span>
                        <button type="button" class="btn-tag tag-destacado" onclick="agregarTexto('A24 Vibes')">✦ A24 Vibes</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Cine de Autor')">Cine de Autor</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Cyberpunk')">Cyberpunk</button>
                        <button type="button" class="btn-tag" onclick="agregarTexto('Sci-Fi 70s')">Sci-Fi 70s</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MENSAJES DEL BUSCADOR -->
        <div id="resultado" class="cineura-estado text-center fs-5 my-4" role="status"></div>

        <!-- RESULTADO DE LA RECOMENDACIÓN -->
        <div id="recomendacion" class="cineura-recomendacion mb-5">
            <div class="row g-0">
                <div class="col-md-5" id="zonaPoster">
                    <div class="cineura-poster-vacio">
                        <span>✦ CINEURA</span>
                    </div>
                </div>

                <div class="col-md-7">
                    <div class="cineura-detalle">
                        <div class="cineura-subtitulo mb-2">✦ RECOMENDACIÓN PARA VOS</div>
                        <h2 id="tituloPelicula">Tu próxima película</h2>
                        <div id="etiquetasPelicula" class="my-3"></div>
                        <p id="datosPelicula" class="cineura-datos"></p>

                        <h3 class="mt-4 fs-5 text-white">Sinopsis</h3>
                        <p id="descripcionPelicula" class="cineura-descripcion"></p>

                        <div class="cineura-motivo">
                            <h3>¿Por qué la elegimos para vos?</h3>
                            <p id="motivoPelicula"></p>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="button" id="botonDetalles" class="cineura-boton-ia py-2 px-4 w-auto">
                                Ver detalles
                            </button>
                            <button type="button" id="botonOtra" class="cineura-boton-secundario">
                                ↻ Otra recomendación
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PELÍCULAS EN TENDENCIA -->
        <div class="seccion-tendencias mt-5 pt-4">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <div class="cineura-badge-neural d-inline-block mb-1">
                        ● TRENDING NOW &nbsp;•&nbsp; ACTUALIZADO HOY
                    </div>
                    <h2 class="h3 fw-bold text-white mb-0">Películas en Tendencias Globales</h2>
                    <p class="text-secondary small mb-0">Los estrenos más vistos y aclamados de la semana.</p>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">

                <!-- DUNE: PART TWO -->
                <div class="col">
                    <div class="card-pelicula">
                        <div class="card-poster-wrap">
                            <span class="badge-ranking badge-ranking-purple">#1 Tendencia Global</span>
                            <img src="https://image.tmdb.org/t/p/w500/1pdfLvkbY9ohJlCjQH2CZjjYVvJ.jpg"
                                 class="card-poster-img"
                                 alt="Póster de Dune: Part Two"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='https://placehold.co/500x750/111827/FBBF24?text=Dune+Part+Two';" />
                            <div class="card-score">★ 8.7</div>
                        </div>
                        <div class="card-info">
                            <div class="card-meta">2024 • 2h 46m</div>
                            <h4 class="card-titulo">Dune: Part Two</h4>
                            <div class="card-tags">
                                <span class="mini-tag">Sci-Fi Épico</span>
                                <span class="mini-tag">Denis Villeneuve</span>
                            </div>
                            <p class="card-sinopsis">Paul Atreides se une a Chani y los Fremen mientras busca venganza contra los conspiradores.</p>
                        </div>
                    </div>
                </div>

                <!-- POOR THINGS -->
                <div class="col">
                    <div class="card-pelicula">
                        <div class="card-poster-wrap">
                            <span class="badge-ranking badge-ranking-cyan">#2 en Auge</span>
                            <img src="https://image.tmdb.org/t/p/w500/kCGlIMHnOm8JPXq3rXM6c5wMxcT.jpg"
                                 class="card-poster-img"
                                 alt="Póster de Poor Things"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='https://placehold.co/500x750/111827/FBBF24?text=Poor+Things';" />
                            <div class="card-score">★ 8.4</div>
                        </div>
                        <div class="card-info">
                            <div class="card-meta">2023 • 2h 21m</div>
                            <h4 class="card-titulo">Poor Things</h4>
                            <div class="card-tags">
                                <span class="mini-tag">Fantasía Satírica</span>
                                <span class="mini-tag">Yorgos Lanthimos</span>
                            </div>
                            <p class="card-sinopsis">La increíble evolución de Bella Baxter, una joven resucitada por un brillante y excéntrico científico.</p>
                        </div>
                    </div>
                </div>

                <!-- THE SUBSTANCE -->
                <div class="col">
                    <div class="card-pelicula">
                        <div class="card-poster-wrap">
                            <span class="badge-ranking badge-ranking-gold">#3 Más Comentada</span>
                            <img src="https://image.tmdb.org/t/p/w500/lqoMzCcZYEFK729d6qzt349fB4o.jpg"
                                 class="card-poster-img"
                                 alt="Póster de The Substance"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='https://placehold.co/500x750/111827/FBBF24?text=The+Substance';" />
                            <div class="card-score">★ 8.0</div>
                        </div>
                        <div class="card-info">
                            <div class="card-meta">2024 • 2h 21m</div>
                            <h4 class="card-titulo">The Substance</h4>
                            <div class="card-tags">
                                <span class="mini-tag">Body Horror</span>
                                <span class="mini-tag">Coralie Fargeat</span>
                            </div>
                            <p class="card-sinopsis">Una celebridad en declive utiliza una droga clandestina que genera una versión más joven de sí misma.</p>
                        </div>
                    </div>
                </div>

                <!-- ANATOMY OF A FALL -->
                <div class="col">
                    <div class="card-pelicula">
                        <div class="card-poster-wrap">
                            <span class="badge-ranking badge-ranking-dark">#4 Palma de Oro</span>
                            <img src="https://image.tmdb.org/t/p/w500/kQs6keheMwCxJxrzV83VUwFtHkB.jpg"
                                 class="card-poster-img"
                                 alt="Póster de Anatomy of a Fall"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='https://placehold.co/500x750/111827/FBBF24?text=Anatomy+of+a+Fall';" />
                            <div class="card-score">★ 8.1</div>
                        </div>
                        <div class="card-info">
                            <div class="card-meta">2023 • 2h 31m</div>
                            <h4 class="card-titulo">Anatomy of a Fall</h4>
                            <div class="card-tags">
                                <span class="mini-tag">Drama Judicial</span>
                                <span class="mini-tag">Justine Triet</span>
                            </div>
                            <p class="card-sinopsis">Una escritora es acusada de asesinar a su esposo tras una misteriosa caída en su aislado chalet.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<script>
    let ultimaBusqueda = "";
    let ultimaLista = [];
    let indiceActual = 0;

    const formulario = document.getElementById("formBusqueda");
    const campoBusqueda = document.getElementById("busqueda");
    const resultado = document.getElementById("resultado");
    const recomendacion = document.getElementById("recomendacion");
    const botonBuscar = document.getElementById("botonBuscar");

    function agregarTexto(texto) {
        if (campoBusqueda.value.trim() === "") {
            campoBusqueda.value = texto;
        } else {
            campoBusqueda.value += ", " + texto;
        }

        campoBusqueda.focus();
    }

    formulario.addEventListener("submit", async function (e) {
        e.preventDefault();

        ultimaBusqueda = campoBusqueda.value.trim();

        if (!ultimaBusqueda) {
            resultado.textContent = "Escribí qué tipo de película querés ver.";
            return;
        }

        resultado.textContent = "✦ Buscando recomendaciones...";
        recomendacion.style.display = "none";
        botonBuscar.disabled = true;

        try {
            const respuesta = await fetch('@Url.Action("BuscarPeliculas", "Home")', {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: new URLSearchParams({
                    busqueda: ultimaBusqueda
                })
            });

            if (!respuesta.ok) {
                throw new Error("Error del servidor: " + respuesta.status);
            }

            const data = await respuesta.json();

            if (!data || (Array.isArray(data) && data.length === 0)) {
                resultado.textContent =
                    "No encontramos películas para esa búsqueda. Probá con otra descripción.";
                return;
            }

            ultimaLista = Array.isArray(data) ? data : [data];
            indiceActual = 0;

            mostrarPelicula(ultimaLista[indiceActual]);

            resultado.textContent =
                "✦ Encontramos " + ultimaLista.length +
                (ultimaLista.length === 1
                    ? " película para vos."
                    : " películas para vos.");

            recomendacion.style.display = "block";
            recomendacion.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

        } catch (error) {
            console.error(error);
            resultado.textContent =
                "No pudimos obtener las recomendaciones. Revisá el servidor e intentá nuevamente.";
        } finally {
            botonBuscar.disabled = false;
        }
    });

    function mostrarPelicula(p) {
        if (!p) return;

        document.getElementById("tituloPelicula").textContent =
            p.titulo || "Sin título";

        document.getElementById("descripcionPelicula").textContent =
            p.sinopsis || "No hay una sinopsis disponible.";

        document.getElementById("datosPelicula").textContent =
            p.duracionMinutos ? p.duracionMinutos + " min" : "Información no disponible";

        const etiquetas = document.getElementById("etiquetasPelicula");
        etiquetas.replaceChildren();

        [p.genero, p.animo].filter(Boolean).forEach(function (texto) {
            const etiqueta = document.createElement("span");
            etiqueta.className = "cineura-etiqueta";
            etiqueta.textContent = texto;
            etiquetas.appendChild(etiqueta);
        });

        document.getElementById("motivoPelicula").textContent =
            'Esta película coincide con tu búsqueda: "' + ultimaBusqueda + '".';

        const zonaPoster = document.getElementById("zonaPoster");
        zonaPoster.replaceChildren();

        if (p.posterUrl) {
            const imagen = document.createElement("img");
            imagen.src = p.posterUrl;
            imagen.alt = p.titulo || "Póster";
            imagen.className = "cineura-poster";

            imagen.onerror = function () {
                mostrarPosterVacio(p.titulo);
            };

            zonaPoster.appendChild(imagen);
        } else {
            mostrarPosterVacio(p.titulo);
        }

        // Abre la página de detalles de la película seleccionada.
        document.getElementById("botonDetalles").onclick = function () {
            if (!p.idPelicula) {
                alert("No se encontró el ID de esta película en la base de datos.");
                return;
            }

            window.location.href =
                "/Home/Detalles?id=" + encodeURIComponent(p.idPelicula);
        };
    }

    function mostrarPosterVacio(titulo) {
        const zonaPoster = document.getElementById("zonaPoster");
        zonaPoster.replaceChildren();

        const espacio = document.createElement("div");
        espacio.className = "cineura-poster-vacio";

        const texto = document.createElement("span");
        texto.textContent = titulo || "✦ CINEURA";

        espacio.appendChild(texto);
        zonaPoster.appendChild(espacio);
    }

    document.getElementById("botonOtra").addEventListener("click", function () {
        if (ultimaLista.length <= 1) {
            resultado.textContent =
                "No hay otra película para esta búsqueda. Probá con otra descripción.";
            return;
        }

        indiceActual = (indiceActual + 1) % ultimaLista.length;
        mostrarPelicula(ultimaLista[indiceActual]);

        resultado.textContent =
            "Recomendación " + (indiceActual + 1) +
            " de " + ultimaLista.length;
    });
</script>

