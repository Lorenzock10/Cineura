
@{
    ViewData["Title"] = Model.Titulo;

    string poster = Model.PosterUrl;
    string titulo = Model.Titulo;
    string sinopsis = Model.Sinopsis;
    string director = "";

    if (ViewBag.Director != null)
    {
        director = ViewBag.Director.ToString();
    }

    if (string.IsNullOrWhiteSpace(poster))
    {
        poster = "";
    }

    if (string.IsNullOrWhiteSpace(titulo))
    {
        titulo = "Película sin título";
    }

    if (string.IsNullOrWhiteSpace(sinopsis))
    {
        sinopsis = "Todavía no hay una sinopsis disponible para esta película.";
    }

    if (string.IsNullOrWhiteSpace(director))
    {
        director = "No disponible";
    }

    bool usuarioConectado = ViewBag.UsuarioConectado == true;
    bool esFavorito = ViewBag.EsFavorito == true;
    bool estaEnWatchlist = ViewBag.EstaEnWatchlist == true;

    int cantidadComentarios = 0;

    if (ViewBag.Comentarios != null)
    {
        cantidadComentarios = ViewBag.Comentarios.Count;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Detalles.css" asp-append-version="true" />
}

<main class="cine-detalle">

    @if (!string.IsNullOrWhiteSpace(poster))
    {
        <div class="cine-detalle-fondo"
             style="background-image: url('@poster');">
        </div>
    }
    else
    {
        <div class="cine-detalle-fondo cine-detalle-fondo-vacio"></div>
    }

    <div class="cine-detalle-fondo-degradado"></div>

    <div class="cine-detalle-contenedor">

        <a href="/Explorador/Index" class="cine-volver">
            <span aria-hidden="true">←</span>
            Volver al explorador
        </a>

        @if (TempData["Mensaje"] != null)
        {
            <div class="cine-mensaje" role="status">
                <span aria-hidden="true">✓</span>
                @TempData["Mensaje"]
            </div>
        }

        <section class="cine-portada">

            <div class="cine-poster-columna">

                @if (!string.IsNullOrWhiteSpace(poster))
                {
                    <div class="cine-poster-marco">
                        <img src="@poster"
                             alt="Póster de @titulo"
                             class="cine-poster" />
                    </div>
                }
                else
                {
                    <div class="cine-poster-marco cine-poster-sin-imagen">
                        <span aria-hidden="true">🎬</span>
                        <p>Póster no disponible</p>
                    </div>
                }

                <span class="cine-poster-pie">
                    <span class="cine-punto"></span>
                    FICHA DE CINEURA
                </span>

                <!-- PUNTUACIÓN DE CINEURA -->
                <div class="cine-calificacion">

                    <p class="cine-calificacion-titulo">TU PUNTUACIÓN</p>

                    <form asp-controller="Home"
                          asp-action="GuardarPuntuacion"
                          method="post"
                          id="form-puntuacion">

                        <input type="hidden"
                               name="idPelicula"
                               value="@Model.IdPelicula" />

                        <input type="hidden"
                               name="puntuacion"
                               id="puntuacion-seleccionada"
                               value="@ViewBag.MiPuntuacion" />

                        <div class="cine-estrellas"
                             role="group"
                             aria-label="Puntuar película">

                            <button type="button" class="cine-estrella" data-valor="1" aria-label="1 de 5">✦</button>
                            <button type="button" class="cine-estrella" data-valor="2" aria-label="2 de 5">✦</button>
                            <button type="button" class="cine-estrella" data-valor="3" aria-label="3 de 5">✦</button>
                            <button type="button" class="cine-estrella" data-valor="4" aria-label="4 de 5">✦</button>
                            <button type="button" class="cine-estrella" data-valor="5" aria-label="5 de 5">✦</button>

                        </div>
                    </form>

                    <p class="cine-calificacion-texto" aria-live="polite">
                        Tu puntuación: @ViewBag.MiPuntuacion de 5
                    </p>

                    <p class="cine-calificacion-texto">
                        Promedio de usuarios: @ViewBag.PromedioPuntuacion / 5
                    </p>

                    @if (!usuarioConectado)
                    {
                        <p>
                            <a asp-controller="Home" asp-action="Login">
                                Iniciá sesión para puntuar
                            </a>
                        </p>
                    }

                </div>

            </div>

            <div class="cine-informacion">

                <div class="cine-etiqueta-superior">
                    CINEURA
                    <span class="cine-separador">/</span>
                    DETALLES DE LA PELÍCULA
                </div>

                <h1 class="cine-titulo">@titulo</h1>

                <div class="cine-datos-principales">

                    @if (Model.Anio > 0)
                    {
                        <span class="cine-dato">
                            <span aria-hidden="true">▦</span>
                            @Model.Anio
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Genero))
                    {
                        <span class="cine-genero">
                            @Model.Genero
                        </span>
                    }

                    @if (Model.DuracionMinutos > 0)
                    {
                        <span class="cine-dato">
                            <span aria-hidden="true">◷</span>
                            @Model.DuracionMinutos min
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Animo))
                    {
                        <span class="cine-animo">
                            ✦ @Model.Animo
                        </span>
                    }

                </div>

                <div class="cine-linea-decorativa">
                    <span></span>
                </div>

                <div class="cine-sinopsis-bloque">
                    <span class="cine-seccion-mini">LA HISTORIA</span>
                    <h2>¿De qué trata?</h2>
                    <p>@sinopsis</p>
                </div>

                <div class="cine-creditos">

                    <div class="cine-credito">
                        <div class="cine-credito-icono">✦</div>
                        <div>
                            <span class="cine-credito-titulo">DIRECCIÓN</span>
                            <p>@director</p>
                        </div>
                    </div>

                    <div class="cine-credito">
                        <div class="cine-credito-icono">♟</div>
                        <div>
                            <span class="cine-credito-titulo">REPARTO</span>

                            @if (ViewBag.Actores != null && ViewBag.Actores.Count > 0)
                            {
                                <p>@string.Join(", ", ViewBag.Actores)</p>
                            }
                            else
                            {
                                <p class="cine-texto-suave">
                                    Todavía no hay actores cargados.
                                </p>
                            }
                        </div>
                    </div>

                </div>

                <div class="cine-acciones">

                    @if (usuarioConectado)
                    {
                        @if (esFavorito)
                        {
                            <form asp-controller="Home"
                                  asp-action="QuitarFavorito"
                                  method="post"
                                  class="cine-formulario-accion">

                                <input type="hidden"
                                       name="idPelicula"
                                       value="@Model.IdPelicula" />

                                <input type="hidden"
                                       name="returnUrl"
                                       value="/Home/Detalles/@Model.IdPelicula" />

                                <button type="submit"
                                        class="cine-boton cine-boton-favorito-activo">
                                    <span aria-hidden="true">♥</span>
                                    En Favoritas
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Home"
                                  asp-action="AgregarFavorito"
                                  method="post"
                                  class="cine-formulario-accion">

                                <input type="hidden"
                                       name="idPelicula"
                                       value="@Model.IdPelicula" />

                                <input type="hidden"
                                       name="returnUrl"
                                       value="/Home/Detalles/@Model.IdPelicula" />

                                <button type="submit" class="cine-boton cine-boton-principal">
                                    <span aria-hidden="true">♥</span>
                                    Agregar a Favoritas
                                </button>
                            </form>
                        }

                        @if (estaEnWatchlist)
                        {
                            <form asp-controller="Watchlist"
                                  asp-action="QuitarWatchlist"
                                  method="post"
                                  class="cine-formulario-accion">

                                <input type="hidden"
                                       name="idPelicula"
                                       value="@Model.IdPelicula" />

                                <input type="hidden"
                                       name="returnUrl"
                                       value="/Home/Detalles/@Model.IdPelicula" />

                                <button type="submit" class="cine-boton cine-boton-secundario">
                                    <span aria-hidden="true">✓</span>
                                    En Watchlist
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Watchlist"
                                  asp-action="AgregarWatchlist"
                                  method="post"
                                  class="cine-formulario-accion">

                                <input type="hidden"
                                       name="idPelicula"
                                       value="@Model.IdPelicula" />

                                <input type="hidden"
                                       name="returnUrl"
                                       value="/Home/Detalles/@Model.IdPelicula" />

                                <button type="submit" class="cine-boton cine-boton-secundario">
                                    <span aria-hidden="true">＋</span>
                                    Agregar a Watchlist
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <a asp-controller="Home"
                           asp-action="Login"
                           class="cine-boton cine-boton-principal">
                            <span aria-hidden="true">♥</span>
                            Iniciá sesión para guardar
                        </a>
                    }

                </div>

                <p class="cine-nota-acciones">
                    Organizá tus películas y guardá las que querés ver.
                </p>

            </div>

        </section>

        <!-- REVIEWS DE LA COMUNIDAD -->
        <section class="cine-reviews">

            <div class="cine-reviews-titulo">

                <div>
                    <span class="cine-seccion-mini">OPINIONES DE LA COMUNIDAD</span>
                    <h2>Reviews</h2>
                </div>

                <span class="cine-reviews-total">
                    @cantidadComentarios opiniones
                </span>

            </div>

            <!-- BOTÓN PARA ESCRIBIR REVIEW -->
            @if (usuarioConectado)
            {
                <details class="cine-review-nueva">

                    <summary>＋ Escribir una review</summary>

                    <form asp-controller="Home"
                          asp-action="AgregarComentario"
                          method="post"
                          class="cine-review-form">

                        <input type="hidden"
                               name="idPelicula"
                               value="@Model.IdPelicula" />

                        <textarea name="texto"
                                  maxlength="1000"
                                  required
                                  placeholder="¿Qué te pareció esta película?"></textarea>

                        <button type="submit"
                                class="cine-boton cine-boton-principal">
                            Publicar review
                        </button>

                    </form>

                </details>
            }
            else
            {
                <a asp-controller="Home"
                   asp-action="Login"
                   class="cine-boton cine-boton-principal cine-review-login">
                    Iniciá sesión para escribir una review
                </a>
            }

            <!-- BOTÓN PARA MOSTRAR Y OCULTAR REVIEWS -->
            @if (cantidadComentarios > 0)
            {
                <details class="cine-reviews-desplegable">

                    <summary>
                        Reviews (@cantidadComentarios)
                    </summary>

                    <div class="cine-reviews-lista">

                        @foreach (Comentarios comentario in ViewBag.Comentarios)
                        {
                            <article class="cine-review">

                                <div class="cine-review-encabezado">

                                    <div class="cine-review-usuario">

                                        <div class="cine-review-avatar">
                                            @if (!string.IsNullOrWhiteSpace(comentario.NombreUsuario))
                                            {
                                                @comentario.NombreUsuario.Substring(0, 1).ToUpper()
                                            }
                                            else
                                            {
                                                <span>U</span>
                                            }
                                        </div>

                                        <div>
                                            <strong>@comentario.NombreUsuario</strong>

                                            <span class="cine-review-fecha">
                                                @comentario.Fecha.ToString("dd/MM/yyyy")
                                            </span>
                                        </div>

                                    </div>

                                    <!-- MENÚ DE OPCIONES DEL USUARIO -->
                                    @if (usuarioConectado &&
                                         comentario.IdUsuario == (int)ViewBag.IdUsuario)
                                    {
                                        <details class="cine-review-menu">

                                            <summary>⋯</summary>

                                            <div class="cine-review-menu-contenido">

                                                <!-- EDITAR REVIEW -->
                                                <details>
                                                    <summary>Editar review</summary>

                                                    <form asp-controller="Home"
                                                          asp-action="EditarComentario"
                                                          method="post"
                                                          class="cine-review-form">

                                                        <input type="hidden"
                                                               name="idComentario"
                                                               value="@comentario.IdComentario" />

                                                        <input type="hidden"
                                                               name="idPelicula"
                                                               value="@Model.IdPelicula" />

                                                        <textarea name="texto"
                                                                  maxlength="1000"
                                                                  required>@comentario.Texto</textarea>

                                                        <button type="submit"
                                                                class="cine-boton cine-boton-principal">
                                                            Guardar cambios
                                                        </button>

                                                    </form>
                                                </details>

                                                <!-- ELIMINAR REVIEW -->
                                                <form asp-controller="Home"
                                                      asp-action="EliminarComentario"
                                                      method="post"
                                                      onsubmit="return confirm('¿Querés eliminar esta review?');">

                                                    <input type="hidden"
                                                           name="idComentario"
                                                           value="@comentario.IdComentario" />

                                                    <input type="hidden"
                                                           name="idPelicula"
                                                           value="@Model.IdPelicula" />

                                                    <button type="submit">
                                                        Eliminar review
                                                    </button>

                                                </form>

                                            </div>

                                        </details>
                                    }

                                </div>

                                <!-- TEXTO DE LA REVIEW -->
                                <div class="cine-review-contenido">

                                    <p class="cine-review-texto cine-review-corto">
                                        @comentario.Texto
                                    </p>

                                    @if (!string.IsNullOrEmpty(comentario.Texto) &&
                                         comentario.Texto.Length > 180)
                                    {
                                        <button type="button"
                                                class="cine-review-leer-mas">
                                            Leer más
                                        </button>
                                    }

                                </div>

                            </article>
                        }

                    </div>

                </details>
            }
            else
            {
                <p class="cine-reviews-vacias">
                    Todavía no hay reviews para esta película.
                    ¡Sé el primero en compartir tu opinión!
                </p>
            }

        </section>

        <!-- PANEL INFERIOR -->
        <section class="cine-panel-extra">

            <div class="cine-panel-encabezado">
                <div>
                    <span class="cine-seccion-mini">DESCUBRÍ MÁS</span>
                    <h2>Tu próxima experiencia cinematográfica</h2>
                </div>

                <span class="cine-panel-simbolo" aria-hidden="true">✦</span>
            </div>

            <div class="cine-panel-tarjetas">

                <article class="cine-tarjeta-extra">
                    <div class="cine-tarjeta-icono cine-icono-rojo">♥</div>
                    <div>
                        <h3>Tus favoritas</h3>
                        <p>Guardá las películas que más te gustan para encontrarlas fácilmente.</p>

                        @if (usuarioConectado)
                        {
                            <a asp-controller="Home" asp-action="Favoritas">
                                Ver mis favoritas <span aria-hidden="true">→</span>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Login">
                                Iniciar sesión <span aria-hidden="true">→</span>
                            </a>
                        }
                    </div>
                </article>

                <article class="cine-tarjeta-extra">
                    <div class="cine-tarjeta-icono cine-icono-oro">＋</div>
                    <div>
                        <h3>Tu Watchlist</h3>
                        <p>Creá tu lista de películas pendientes para tu próxima noche de cine.</p>

                        @if (usuarioConectado)
                        {
                            <a asp-controller="Watchlist" asp-action="Index">
                                Ver mi Watchlist <span aria-hidden="true">→</span>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Login">
                                Iniciar sesión <span aria-hidden="true">→</span>
                            </a>
                        }
                    </div>
                </article>

                <article class="cine-tarjeta-extra">
                    <div class="cine-tarjeta-icono cine-icono-azul">⌕</div>
                    <div>
                        <h3>Seguí explorando</h3>
                        <p>Encontrá otras películas según tus gustos y descubrí nuevas historias.</p>

                        <a href="/Explorador/Index">
                            Explorar películas <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </article>

            </div>

            <div class="cine-frase-final">
                <span aria-hidden="true">“</span>
                Cada película tiene una historia. Encontrá la próxima que te deje algo.
            </div>

        </section>

    </div>

</main>
