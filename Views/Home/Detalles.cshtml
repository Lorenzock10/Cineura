
@model Cineura.Models.Peliculas

@{
    ViewData["Title"] = Model.Titulo;

    string poster = !string.IsNullOrWhiteSpace(Model.PosterUrl)
        ? Model.PosterUrl
        : "";
}

<div class="detalles-pagina">

    <a asp-controller="Home" asp-action="Index" class="detalles-volver">
        ← Volver al inicio
    </a>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success mt-3" role="alert">
            @TempData["Mensaje"]
        </div>
    }

    <div class="detalles-contenido">

        @if (!string.IsNullOrWhiteSpace(poster))
        {
            <img src="@poster"
                 alt="Póster de @Model.Titulo"
                 class="detalles-poster" />
        }

        <div class="detalles-info">
            <h1>@Model.Titulo</h1>

            <div class="detalles-etiquetas">
                <span>@Model.Anio</span>
                <span>@Model.Genero</span>
                <span>@Model.DuracionMinutos minutos</span>
                <span>@Model.Animo</span>
            </div>

            <h3>Sinopsis</h3>
            <p class="detalles-sinopsis">
                @(string.IsNullOrWhiteSpace(Model.Sinopsis)
                    ? "No hay una sinopsis cargada para esta película."
                    : Model.Sinopsis)
            </p>

            <p>
                <strong>Director:</strong>
                @ViewBag.Director
            </p>

            <p>
                <strong>Actores:</strong>

                @if (ViewBag.Actores != null && ViewBag.Actores.Count > 0)
                {
                    @string.Join(", ", ViewBag.Actores)
                }
                else
                {
                    <span>No hay actores cargados.</span>
                }
            </p>

            @if (ViewBag.UsuarioConectado == true)
            {
                <div class="d-flex flex-wrap gap-2 mt-4">

                    @if (ViewBag.EsFavorito == true)
                    {
                        <form asp-controller="Home" asp-action="QuitarFavorito" method="post">
                            <input type="hidden" name="idPelicula" value="@Model.IdPelicula" />
                            <input type="hidden" name="returnUrl" value="/Home/Detalles/@Model.IdPelicula" />

                            <button type="submit" class="detalles-boton detalles-boton-secundario">
                                ♥ Quitar de Favoritas
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Home" asp-action="AgregarFavorito" method="post">
                            <input type="hidden" name="idPelicula" value="@Model.IdPelicula" />
                            <input type="hidden" name="returnUrl" value="/Home/Detalles/@Model.IdPelicula" />

                            <button type="submit" class="detalles-boton">
                                ♥ Agregar a Favoritas
                            </button>
                        </form>
                    }

                    @if (ViewBag.EstaEnWatchlist == true)
                    {
                        <form asp-controller="Home" asp-action="QuitarWatchlist" method="post">
                            <input type="hidden" name="idPelicula" value="@Model.IdPelicula" />
                            <input type="hidden" name="returnUrl" value="/Home/Detalles/@Model.IdPelicula" />

                            <button type="submit" class="detalles-boton detalles-boton-secundario">
                                ✓ Quitar de Watchlist
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Home" asp-action="AgregarWatchlist" method="post">
                            <input type="hidden" name="idPelicula" value="@Model.IdPelicula" />
                            <input type="hidden" name="returnUrl" value="/Home/Detalles/@Model.IdPelicula" />

                            <button type="submit" class="detalles-boton">
                                + Agregar a Watchlist
                            </button>
                        </form>
                    }

                </div>
            }
            else
            {
                <p>Iniciá sesión para guardar esta película en tus listas.</p>

                <a asp-controller="Home"
                   asp-action="Login"
                   class="detalles-boton">
                    Iniciar sesión
                </a>
            }
        </div>
    </div>
</div>
