
@model List<Cineura.Models.Peliculas>

<section class="explorador-resultados" id="peliculas">

    <div class="explorador-resultados-titulo">
        <div>
            <span class="explorador-mini-etiqueta">
                EL CATÁLOGO DE CINEURA
            </span>

            <h2>Descubrí películas</h2>

            <p>
                Explorá todas las historias que tenemos para vos.
            </p>
        </div>

        <div class="explorador-cantidad">
            <span class="explorador-cantidad-numero">
                @Model.Count
            </span>

            <span class="explorador-cantidad-texto">
                PELÍCULAS
            </span>
        </div>
    </div>

    @if (Model.Count > 0)
    {
        <div class="explorador-grilla-resultados">

            @foreach (Cineura.Models.Peliculas pelicula in Model)
            {
                <div class="explorador-tarjeta">

                    <a href="/Home/Detalles/@pelicula.IdPelicula"
                       class="explorador-poster-link"
                       title="@pelicula.Titulo">

                        @if (!string.IsNullOrWhiteSpace(pelicula.PosterUrl))
                        {
                            <img class="explorador-poster"
                                 src="@pelicula.PosterUrl"
                                 alt="Póster de @pelicula.Titulo"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="explorador-poster-vacio">
                                <span>✦</span>
                                <p>CINEURA</p>
                            </div>
                        }

                    </a>

               

                </div>
            }

        </div>
    }
    else
    {
        <div class="explorador-sin-resultados">

            <div class="explorador-sin-resultados-icono">
                ⌕
            </div>

            <h3>No encontramos películas</h3>

            <p>
                Probá cambiando la búsqueda o quitando alguno de los filtros.
            </p>

            <a href="/Explorador/Index">
                Ver todas las películas
            </a>

        </div>
    }

</section>
